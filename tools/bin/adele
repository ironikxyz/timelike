#!/opt/timelike/python/bin/python3 -I
"""adele — ask Adele, the authority for reaching actions, to act within the operator's grant (P4).

The agent never holds a credential. `adele request` sends a request to Adele's request interface;
she checks it against the grant the operator wrote, performs it with a credential the agent never
sees, and records it in her ledger. Beyond the grant, nothing is performed and the call exits 4 with
the grant envelope on stdout: the grant, the limit and the operator's command to extend it (T1;
grant-envelope.schema.json, discovery revision 10). That command is the operator's: the agent cannot
run it, and it is never offered where the agent's habit runs commands (`confirm`).

The grant is the confirmation (P4) for every request a grant limits, so `--yes` confirms none of them.
Feature 13 slice 2 adds two verbs rule 9 binds whatever the grant says: `adele env restore` replaces a
volume's contents and `adele env snapshot-rm` deletes the only copy of a past state. Only those two take
`--yes` (and `--dry-run`); without it they exit 4 with the confirmation envelope, whose `confirm` is the
agent's own command. Any other exit 4 is the grant envelope, whose command is the operator's. The status
says which (plan R31).

Slice 1: Adele reaps what expires, in her own container, whatever the agent does; `adele status [HOST]`
explains recent denials by host, read-only from her ledger; each request carries the agent's name
(TIMELIKE_AGENT) beside its session, as attribution only.

Feature 13 slice 0: `adele env up|status|down` brings up the project's own compose environment through
Adele, waits until each service is ready (probing its ports from this container), and tears it down.
Adele resolves the project in a sandbox, refuses settings that escape a container (exit 2: no grant
allows them) and runs only what she checked (.specswarm/features/014-nested-dev-env/).

Feature 13 slice 1: `adele env up` also brings up a project's devcontainer (`--devcontainer`, or chosen
when no compose file is named or present and the project has one), builds what it names with nothing
pulled, and names each build and lifecycle command; a service with no readiness signal is "running, no
readiness check", never ready (decision C). `adele env exec [NAME] -- CMD` runs a command in an environment
and passes its exit status through, as 03's `run` does; `adele env collect` removes the environments of
ended sessions now; `adele session end` ends this session (014 contracts/adele-env.md § Slice 1, plan
R12-R20).

Feature 13 slice 2: `adele env snapshot|snapshots|restore|snapshot-rm` take, list, restore and remove
snapshots of a nested environment's named Docker volumes, through Adele and under the grant's cap; a
restore waits for readiness as `up` does. The workspace's own files are feature 07's `snapshot` and `undo`
(014 contracts/adele-env.md § Slice 2, plan R27, R31, R32).

Design: .specswarm/features/004-adele-grants/ (spec, research R6-R8, contracts/adele-cli.md and
adele-http.md).
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import re
import time
from typing import Any

import agentio

DEFAULT_URL = "http://adele:8480"
URL_ENV = "TIMELIKE_ADELE_URL"
DEFAULT_TIMEOUT_S = 30.0
EXEC_TIMEOUT_S = 100.0  # env exec's bound by default: feature 03's run default (014 plan R17)
EXEC_HTTP_SLACK_S = 30.0  # Adele's answer may follow the command's bound by this much
STATUS_TIMEOUT_S = 3.0  # the conformance probe must conclude well inside conform's 10 s (R8)
VANTAGE = "from the agent container"  # H3: a reachability claim names where it was made
# 014 plan R32 A: a text verdict is printed as "verdict: …" and rule 13 cuts that line at 200 columns, so the
# verdict itself has the rest. Each up, restore and snapshot verdict is built to fit at a 30-character name.
VERDICT_MAX = agentio.DEFAULT_COLUMNS - len("verdict: ")
# Where the record lives, named in status's verdict (Item 26 Q2, the mentor: the D8 interview found the
# operator did not know). The agent cannot run the command; it is named so a person reading it can. The
# verdict keeps it short, so that with the stand-in's host and both of status's figures it fits rule 13's
# 200 columns; the data says it whole.
RECORD = "record: adeled ledger"
RECORD_WHOLE = "Adele's ledger, which the operator reads with: docker exec timelike-adele adeled ledger"
UNBLOCK = "the operator starts her: make up (docker compose up -d) on the host"
_TTL_RE = re.compile(r"^([0-9]+h)?([0-9]+m)?$")
# Feature 13 (014 research R7): the bring-up's bound, and how often Adele's read-back is polled.
ENV_WAIT_S = 120.0
ENV_WAIT_MAX_S = 600.0
ENV_POLL_S = 0.5
ENV_PROBE_S = 1.0
WORKSPACE_ENV = "TIMELIKE_WORKSPACE"
_ENV_NAME_RE = re.compile(r"^tl-[a-z0-9][a-z0-9-]{0,59}$")
ENV_VERBS = ("up", "status", "down", "exec", "collect", "snapshot", "snapshots", "restore", "snapshot-rm")
SNAPSHOT_VERBS = ("snapshot", "restore", "snapshot-rm")  # each takes [NAME] and one more operand
CONFIRMED_VERBS = ("restore", "snapshot-rm")  # rule 9 binds these two: --yes, --dry-run (plan R31)
# A snapshot's or a restore's answer: Adele's copy (5 min), measure and digest (2 min each), the stops (10 s
# each) and her own bounded wait for healthchecks (014 plan, Technical Context: Bounds), with room.
SNAPSHOT_HTTP_S = 900.0
SNAPSHOT_RM_HTTP_S = 120.0  # a volume's removal, read back gone
# A collect's answer (lane 13s2a): Adele's pass starts no removal after 5 min, and answers within 10 min
# (broker.CollectBound, CollectWriteTimeout); this waits a minute past that.
COLLECT_PASS_S = 300.0
COLLECT_HTTP_S = 660.0
NOTE_MAX = 200  # a snapshot's note, in characters (contract § Slice 2)
# 014 plan R12: a project whose root holds one of these is a compose project, unless --devcontainer.
COMPOSE_FILES = ("compose.yaml", "compose.yml", "docker-compose.yaml", "docker-compose.yml")
DEVCONTAINER_FILES = (".devcontainer/devcontainer.json", ".devcontainer.json")
LAST_LINES_MAX = 300  # the characters of a failure's last lines a one-line error carries

TOOL = agentio.Tool(
    name="adele",
    target="adele",
    summary="ask Adele for a reaching action within the operator's grant; never see a credential;"
    " a nested environment's Docker volumes: adele env snapshot|restore (workspace files: snapshot, undo)",
    usage=[
        "adele status [HOST]           # reachable from here; her revision; recent denials (of HOST)",
        "adele grants                  # the grants she applies: limits, spent, live",
        "adele request standin.box create --name NAME [--ttl 1h] [--port 8080 ...] [--grant G]",
        "adele env up [DIR] [--devcontainer] [-f FILE] [--profile P] [--wait 120]  # compose or devcontainer",
        "adele env status [NAME] | adele env down [NAME|DIR]  # each service, its address; remove it all",
        "adele env exec [NAME] [--service S] [--timeout 100] -- CMD [ARG]...  # exits with CMD's status",
        "adele env collect | adele session end  # remove ended sessions' environments; end this session",
        "adele env snapshot [NAME] VOLUME [--note T] | adele env snapshots [NAME]  # an env's Docker volumes",
        "adele env restore [NAME] SNAPSHOT [--yes|--dry-run] [--wait 120] | adele env snapshot-rm [NAME] S",
        "  (the workspace's own files are snapshot and undo; these are a nested environment's volumes)",
        "exit 4: beyond the grant; nothing performed; stdout is the grant envelope (operator's command);",
        "  or env restore / snapshot-rm without --yes: stdout is the confirmation envelope (your command)",
        "extend is the OPERATOR's command, run on the host (docker exec timelike-adele adeled extend ...);",
        "every request, refusal and reap is in Adele's ledger (the operator's: adeled ledger)",
    ],
    probe=("status",),
    grant_envelope=True,  # exit 4 is the grant envelope; not --yes-confirmed (discovery revision 10)
    # 014 plan R31: env restore and env snapshot-rm cannot be undone from what the tool shows, so rule 9 binds
    # them (and rule 8: --dry-run). agentio admits a grant client that confirms only when confirm_protocol is
    # declared; every other verb refuses --yes and --dry-run (see main), so the grant stays its confirmation.
    mutating=True,
    confirm_protocol=True,
    destructive=True,
    # `env exec`'s command follows `--` (feature 010's split, before argparse). Its exit is passed through
    # by that verb alone: see env_exec. passes_exit is not declared Tool-wide: it would split every verb's
    # argv at its first plain word, and have conform wrap a local command adele does not run.
    takes_command=True,
    exit_codes={
        agentio.EXIT_OK: "ok",
        agentio.EXIT_FAILURE: "unreachable, or the capability failed (env up: a build, lifecycle command"
        " or service; env restore: a service not ready)",
        agentio.EXIT_USAGE: "usage; or name one with --grant; env: a setting no grant allows, a bad"
        " devcontainer.json",
        agentio.EXIT_NOT_FOUND: "no grant, environment, service, volume or snapshot by that name; env: an"
        " image not on the daemon",
        agentio.EXIT_CONFIRM: "beyond the grant, nothing performed; or env restore, snapshot-rm without"
        " --yes",
        agentio.EXIT_TIMEOUT: "own limit fired (env up: not ready within --wait, a build or lifecycle bound;"
        " env exec: --timeout)",
    },
    manifest_extra=lambda: {
        "url_env": URL_ENV,
        "default_url": DEFAULT_URL,
        "default_timeout_s": DEFAULT_TIMEOUT_S,
        "exec_default_timeout_s": EXEC_TIMEOUT_S,
        "capabilities": ["standin.box", "docker.compose"],
        "env_wait_s": ENV_WAIT_S,
        "env_wait_max_s": ENV_WAIT_MAX_S,
    },
)


def configure(p: argparse.ArgumentParser) -> None:
    # Optional to argparse, required by main(): a required positional would make argparse refuse
    # --help and --agent-info before agentio handles them.
    p.add_argument(
        "verb", nargs="?", choices=("status", "grants", "request", "env", "session"), metavar="VERB"
    )
    p.add_argument(
        "capability",
        nargs="?",
        metavar="CAPABILITY",
        help="request's capability; status: a HOST; env: a verb (see usage); session: end",
    )
    p.add_argument(
        "action", nargs="?", metavar="ACTION", help="request's action; env: a DIR or an environment NAME"
    )
    p.add_argument(
        "operand", nargs="?", metavar="ARG", help="env snapshot: VOLUME; restore, snapshot-rm: SNAPSHOT"
    )
    p.add_argument("--name", metavar="NAME", help="the resource's name")
    p.add_argument("--ttl", metavar="D", help="its lifetime, e.g. 30m or 1h (default: the grant's ttl)")
    p.add_argument("--port", type=int, action="append", default=[], metavar="P", help="a port it exposes")
    p.add_argument("--grant", metavar="G", help="the grant to use (default: the one that allows it)")
    p.add_argument(
        "--timeout",
        type=float,
        default=None,  # resolved per verb in main(): DEFAULT_TIMEOUT_S, or EXEC_TIMEOUT_S for env exec
        metavar="S",
        help=f"give up after S seconds (default {DEFAULT_TIMEOUT_S:g}; env exec: {EXEC_TIMEOUT_S:g})",
    )
    p.add_argument(
        "-f", "--file", action="append", default=[], metavar="FILE", help="env: a compose file in DIR"
    )
    p.add_argument("--profile", action="append", default=[], metavar="P", help="env: a compose profile")
    p.add_argument("--project", metavar="NAME", help="env: the environment's name (default: from DIR)")
    p.add_argument(
        "--devcontainer", action="store_true", help="env up: the project's devcontainer, not its compose file"
    )
    p.add_argument("--service", metavar="S", help="env exec: the service to run in (default: its only one)")
    p.add_argument(
        "--wait",
        type=float,
        default=ENV_WAIT_S,
        metavar="S",
        help=f"env up, restore: ready within S s (at most {ENV_WAIT_MAX_S:g})",
    )
    p.add_argument("--note", metavar="TEXT", help=f"env snapshot: a note kept with it (at most {NOTE_MAX})")


class Reply:
    """One HTTP exchange with Adele: a status and a JSON body, or the reason there was none."""

    __slots__ = ("body", "reason", "status", "timed_out")

    def __init__(self, status: int, body: dict[str, Any], reason: str = "", timed_out: bool = False) -> None:
        self.status = status
        self.body = body
        self.reason = reason
        self.timed_out = timed_out


def base_url() -> str:
    return os.environ.get(URL_ENV, DEFAULT_URL).rstrip("/")


def call(method: str, path: str, timeout: float, payload: dict[str, Any] | None = None) -> Reply:
    """status 0 means no HTTP answer at all; `reason` then says why (urllib is imported here, R6)."""
    # Imported here, not at the top: keeps --help and --agent-info on agentio's start-up path (R6).
    import urllib.error
    import urllib.request

    data = None if payload is None else json.dumps(payload).encode()
    req = urllib.request.Request(  # noqa: S310 — the URL is Adele's, from the image's environment
        base_url() + path, data=data, method=method, headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:  # noqa: S310
            return Reply(resp.status, _json(resp.read()))
    except urllib.error.HTTPError as e:
        return Reply(e.code, _json(e.read()))
    except TimeoutError:
        return Reply(0, {}, f"no answer within {timeout:g} s", timed_out=True)
    except urllib.error.URLError as e:
        if isinstance(e.reason, TimeoutError):
            return Reply(0, {}, f"no answer within {timeout:g} s", timed_out=True)
        return Reply(0, {}, str(e.reason))
    except OSError as e:
        return Reply(0, {}, e.strerror or str(e))


def _json(raw: bytes) -> dict[str, Any]:
    try:
        doc = json.loads(raw or b"{}")
    except ValueError:
        return {"error": "Adele answered with something that is not JSON"}
    return doc if isinstance(doc, dict) else {"error": "Adele answered with JSON that is not an object"}


def unreachable(reply: Reply, timeout: float) -> agentio.ToolError:
    if reply.timed_out:
        return agentio.ToolError(
            agentio.EXIT_TIMEOUT,
            f"Adele at {base_url()} gave no answer within {timeout:g} s ({VANTAGE})",
            "raise the limit with --timeout, or ask the operator whether Adele is running",
        )
    return agentio.ToolError(
        agentio.EXIT_FAILURE, f"cannot reach Adele at {base_url()} ({VANTAGE}): {reply.reason}", UNBLOCK
    )


def status(ctx: agentio.Context, host: str | None = None) -> agentio.Result:
    """Always a Result, never a ToolError, so the header is printed either way (conform C3/C4, R8). When
    Adele answers, the verdict also says whether she denied anything recently, and each denial is
    explained, newest first (004 slice 1, FR-36): read-only, from her ledger, through her."""
    reply = call("GET", "/v1/health", STATUS_TIMEOUT_S)
    if reply.status == 200:
        rev = str(reply.body.get("revision", "unknown"))
        grants = [str(g) for g in reply.body.get("grants", [])]
        verdict = f"Adele reachable at {base_url()} {VANTAGE} · revision {rev}"
        data: dict[str, Any] = {"reachable": True, "url": base_url(), "revision": rev, "grants": grants}
        said, lines, extra = denials(host)
        data.update(extra)
        data["record"] = RECORD_WHOLE
        return agentio.Result("adele", "status", f"{verdict} · {said} · {RECORD}", lines=lines, data=data)
    if reply.status == 0:
        why = reply.reason
        verdict = f"unreachable: {base_url()} {VANTAGE} ({why}) — {UNBLOCK}"
    else:  # she answered, but not well: reached, and not "unreachable"
        why = f"HTTP {reply.status}: {reply.body.get('error', 'no error text')}"
        verdict = f"Adele at {base_url()} answered {VANTAGE} but not healthy ({why}) — {UNBLOCK}"
    data = {"reachable": reply.status != 0, "url": base_url(), "reason": why}
    return agentio.Result("adele", "status", verdict, data=data, exit=agentio.EXIT_FAILURE)


def denials(host: str | None) -> tuple[str, list[str], dict[str, Any]]:
    """(the verdict's words, one line per denial, the data) from /v1/denials. An Adele that cannot say is
    named as such, never read as "no denial"."""
    import urllib.parse

    path = "/v1/denials" + (f"?host={urllib.parse.quote(host, safe='')}" if host else "")
    reply = call("GET", path, STATUS_TIMEOUT_S)
    where = f" of {host}" if host else ""
    if reply.status != 200 or not isinstance(reply.body.get("denials"), list):
        why = reply.reason or f"HTTP {reply.status}: {reply.body.get('error', 'no denials in the answer')}"
        return f"denials{where} unknown ({why})", [], {"denials": None, "denials_unknown": why}
    items = [d for d in reply.body["denials"] if isinstance(d, dict)]
    hours, per_host = reply.body.get("window_hours", 24), reply.body.get("per_host", 20)
    data = {"denials": items, "denial_window_hours": hours, "denial_host": host}
    if not items:
        return f"no denial{where} in {hours} h", [], data
    s = "s" if len(items) != 1 else ""
    said = f"{len(items)} denial{s}{where} in {hours} h (≤{per_host}/host)"  # newest first, below
    return said, [_denial_line(d) for d in items], data


def _denial_line(d: dict[str, Any]) -> str:
    raw = d.get("limit")
    lim: dict[str, Any] = raw if isinstance(raw, dict) else {}
    host = d.get("host") or "(no host recorded)"
    who = f"session {d.get('session')}" + (f", agent {d['agent']}" if d.get("agent") else "")
    # A forbidden setting has no operator's command: no grant allows it (feature 13, prompt 13 revision 17).
    op = f"operator: {d.get('extend')}" if d.get("extend") else "operator's command: none"
    return (
        f"#{d.get('ledger_id')} {d.get('at')} {host}: grant {d.get('grant')}, {lim.get('name')} allows"
        f" {lim.get('allowed')}, needed {lim.get('needed')} · {op}"
        f" ({who})"
    )


def grants(timeout: float) -> agentio.Result:
    reply = call("GET", "/v1/grants", timeout)
    if reply.status == 0:
        raise unreachable(reply, timeout)
    if reply.status != 200:
        raise answered_error(reply)
    items = reply.body.get("grants", [])
    lines = [
        f"{g.get('name')}: {', '.join(g.get('capabilities', []))} · budget {_usd(g.get('budget_cents'))}"
        f" (spent {_usd(g.get('spent_cents'))}) · ttl {g.get('ttl')} · instances {g.get('live')}/"
        f"{g.get('instances')} · ports {g.get('ports')}"
        for g in items
    ]
    verdict = f"{len(items)} grant{'s' if len(items) != 1 else ''}"
    return agentio.Result(
        "adele", "grants", verdict, lines=lines, data={"grants": items, "count": len(items)}
    )


def _usd(cents: Any) -> str:
    return f"{int(cents or 0) / 100:.2f} USD"


def request(args: argparse.Namespace, ctx: agentio.Context) -> agentio.Result:
    payload = build_request(args)
    target = f"{args.capability}"
    reply = call("POST", "/v1/requests", args.timeout, payload)
    if reply.status == 0:
        raise unreachable(reply, args.timeout)
    body = reply.body
    if reply.status == 200:
        verdict = (
            f"performed under grant {body.get('grant')} · box {body.get('resource')}"
            f" · {_usd(body.get('cost_cents'))} · expires {body.get('expires_at')}"
        )
        return agentio.Result(target, args.action, verdict, data=_performed(body))
    if reply.status == 403:
        return refused(ctx, args, payload, body)
    raise answered_error(reply)


def build_request(args: argparse.Namespace) -> dict[str, Any]:
    if not args.capability or not args.action:
        raise agentio.UsageError(
            "request needs a capability and an action", "e.g. adele request standin.box create --name tl-1"
        )
    if not args.name:
        raise agentio.UsageError("request needs --name", "name the resource, e.g. --name tl-1")
    if args.ttl is not None and not (_TTL_RE.match(args.ttl) and args.ttl):
        raise agentio.UsageError(f"--ttl {args.ttl!r} is not a duration like 30m or 1h", "use h and m")
    req: dict[str, Any] = {
        "session": agentio.session_id(),
        "grant": args.grant,
        "capability": args.capability,
        "action": args.action,
        "params": {"name": args.name, "ttl": args.ttl, "ports": list(args.port)},
    }
    agent = agentio.agent_name()
    if agent is not None:
        req["agent"] = agent  # attribution beside the session (004 slice 1, FR-32); omitted when unset
    return req


def _performed(body: dict[str, Any]) -> dict[str, Any]:
    keys = ("outcome", "grant", "resource", "cost_cents", "expires_at", "ledger_id", "undo")
    return {k: body.get(k) for k in keys}


def refused(
    ctx: agentio.Context, args: argparse.Namespace, payload: dict[str, Any], body: dict[str, Any]
) -> agentio.Result:
    """Exit 4 with the grant envelope (FOR-MENTOR Item 13, discovery revision 10; T018). Adele's 403
    says what was refused; a 403 that cannot fill the envelope is her failure, never a guessed one."""
    limit = body.get("limit")
    extend = body.get("extend")
    grant = body.get("grant")
    if (
        body.get("performed") is not False
        or not isinstance(limit, dict)
        or not {"name", "allowed", "needed"} <= set(limit)
        or not isinstance(extend, str)
        or not extend
        or not isinstance(grant, str)
        or not grant
    ):
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            "Adele refused the request, but her answer does not name the grant, the limit and the"
            " operator's extend command",
            "nothing was performed, as far as she said; ask the operator to check her ledger",
        )
    ledger_id = body.get("ledger_id")
    return agentio.grant_required(
        ctx,
        target=str(args.capability),
        scope=str(args.action),
        grant=grant,
        limit={k: str(limit[k]) for k in ("name", "allowed", "needed")},
        extend=extend,
        request=payload,
        ledger_id=ledger_id if isinstance(ledger_id, int) and not isinstance(ledger_id, bool) else None,
    )


def answered_error(reply: Reply) -> agentio.ToolError:
    what = str(reply.body.get("error", f"Adele answered HTTP {reply.status}"))
    remedy = str(reply.body.get("remediation", ""))
    names = reply.body.get("grants")
    if names:
        remedy = (remedy + "; " if remedy else "") + "grants: " + ", ".join(str(n) for n in names)
    if reply.status == 404:
        return agentio.ToolError(agentio.EXIT_NOT_FOUND, what, remedy or "list them with adele grants")
    if reply.status == 400:
        return agentio.UsageError(what, remedy or "see adele --help")
    return agentio.ToolError(
        agentio.EXIT_FAILURE, what, remedy or "nothing was performed; retry, or ask the operator"
    )


def main(args: argparse.Namespace, ctx: agentio.Context) -> agentio.Result:
    if args.timeout is None:
        args.timeout = (
            EXEC_TIMEOUT_S if (args.verb, args.capability) == ("env", "exec") else DEFAULT_TIMEOUT_S
        )
    if args.command and (args.verb, args.capability) != ("env", "exec"):
        raise agentio.UsageError("`--` and a command belong to env exec", "e.g. adele env exec -- ls -la")
    if not math.isfinite(args.timeout) or args.timeout <= 0:
        raise agentio.UsageError("--timeout must be more than 0", "e.g. --timeout 30")
    if args.verb is None:
        raise agentio.UsageError("no verb given", "use one of: adele status, adele grants, adele request …")
    env_verb = args.capability if args.verb == "env" else None
    if (args.yes or args.dry_run) and env_verb not in CONFIRMED_VERBS:
        # The grant is the confirmation for every other request (discovery revision 10): --yes would confirm
        # nothing, and nothing else here has a plan to show.
        raise agentio.UsageError(
            f"{'--yes' if args.yes else '--dry-run'} belongs to adele env restore and adele env snapshot-rm",
            "every other request is confirmed by the operator's grant; drop the flag",
        )
    if args.note is not None and env_verb != "snapshot":
        raise agentio.UsageError(
            "--note belongs to adele env snapshot", "e.g. adele env snapshot db-data --note x"
        )
    if args.operand is not None and env_verb not in SNAPSHOT_VERBS:
        raise agentio.UsageError(
            f"unexpected argument {args.operand!r}", f"see {TOOL.name} --help for each verb's arguments"
        )
    if args.verb == "status":
        if args.action is not None:
            raise agentio.UsageError("status takes at most one HOST", "e.g. adele status adele-standin:8481")
        if args.capability is not None and not 0 < len(args.capability) <= 255:
            raise agentio.UsageError("HOST is 1 to 255 characters", "e.g. adele status adele-standin:8481")
        return status(ctx, args.capability)
    if args.verb == "grants":
        return grants(args.timeout)
    if args.verb == "env":
        return env(args, ctx)
    if args.verb == "session":
        return session(args)
    return request(args, ctx)


# ── adele env (feature 13, slice 0) ─────────────────────────────────────────────────────────────


def workspace() -> str:
    ws = os.environ.get(WORKSPACE_ENV, "")
    if not ws:
        raise agentio.UsageError(
            "no workspace was mounted at launch, so there is no project Adele can bring up",
            "the operator launches with a workspace: make up, with TIMELIKE_WORKSPACES set",
        )
    return os.path.realpath(ws)


def _within(path: str, ws: str) -> bool:
    return path == ws or path.startswith(ws.rstrip("/") + "/")


def default_name(directory: str) -> str:
    """tl-<basename slug, at most 40>-<sha256(dir)[:6]>, as Adele's compose.DefaultName (data-model)."""
    slug = re.sub(r"[^a-z0-9]+", "-", os.path.basename(directory).lower()).strip("-")
    slug = slug[:40].strip("-") or "project"
    return f"tl-{slug}-{hashlib.sha256(directory.encode()).hexdigest()[:6]}"


def project_dir(arg: str | None, ws: str) -> str:
    d = os.path.realpath(arg or os.getcwd())
    if not _within(d, ws):
        raise agentio.UsageError(
            f"{d} is not inside the workspace {ws}",
            "bring up a project inside the workspace: cd into it, or name it",
        )
    if not os.path.isdir(d):
        raise agentio.UsageError(f"{d} is not a directory", "name the project's directory")
    return d


def env_name(args: argparse.Namespace, directory: str | None) -> str:
    name = args.project or (default_name(directory) if directory else None)
    if not name or not _ENV_NAME_RE.match(name):
        raise agentio.UsageError(
            f"bad environment name {name!r}",
            "a name is tl-, then a lowercase letter or digit, then a-z, 0-9 and -",
        )
    return str(name)


def env(args: argparse.Namespace, ctx: agentio.Context) -> agentio.Result:
    sub = args.capability
    if sub not in ENV_VERBS:
        raise agentio.UsageError(
            f"env has no verb {sub!r}",
            "use adele env up, adele env status, adele env down, adele env exec, adele env collect,"
            " adele env snapshot, adele env snapshots, adele env restore or adele env snapshot-rm",
        )
    if sub == "status":
        return env_status(args.action, args.timeout)
    if sub == "collect":
        if args.action is not None:
            raise agentio.UsageError("env collect takes no NAME", "run adele env collect")
        return env_collect(args.timeout)
    if sub == "exec":
        return env_exec(args, ctx)
    if sub == "snapshot":
        return env_snapshot(args, ctx)
    if sub == "snapshots":
        return env_snapshots(args, ctx)
    if sub == "restore":
        return env_restore(args, ctx)
    if sub == "snapshot-rm":
        return env_snapshot_rm(args, ctx)
    ws = workspace()
    if sub == "down":
        if args.action and _ENV_NAME_RE.match(args.action):
            name = args.action
        else:
            name = env_name(args, project_dir(args.action, ws))
        return env_down(name, args.timeout)
    return env_up(args, ctx, ws)


def env_payload(args: argparse.Namespace, action: str, name: str, directory: str | None) -> dict[str, Any]:
    req: dict[str, Any] = {
        "session": agentio.session_id(),
        "grant": args.grant if action == "up" else None,
        "capability": "docker.compose",
        "action": action,
        "params": {"name": name, "ttl": args.ttl if action == "up" else None, "ports": []},
    }
    if directory:
        req["params"].update({"dir": directory, "files": list(args.file), "profiles": list(args.profile)})
        if action == "up" and wants_devcontainer(args, directory):
            req["params"]["devcontainer"] = True
    if req["grant"] is None:
        req["grant"] = ""
    if req["params"]["ttl"] is None:
        req["params"]["ttl"] = ""
    agent = agentio.agent_name()
    if agent is not None:
        req["agent"] = agent
    return req


def wants_devcontainer(args: argparse.Namespace, directory: str) -> bool:
    """014 plan R12 "Which file": --devcontainer, or no -f, no root compose file and a devcontainer.json. The
    sandbox checks again: this is a request, not a fact."""
    if args.devcontainer:
        return True
    if args.file or any(os.path.isfile(os.path.join(directory, f)) for f in COMPOSE_FILES):
        return False
    return any(os.path.isfile(os.path.join(directory, f)) for f in DEVCONTAINER_FILES)


def _last(lines: Any) -> str:
    """A failure's last lines on one line, joined with " · ", at most LAST_LINES_MAX characters, the end
    kept."""
    if not isinstance(lines, list):
        return ""
    text = " · ".join(str(x).strip() for x in lines if str(x).strip())
    return text if len(text) <= LAST_LINES_MAX else "…" + text[-(LAST_LINES_MAX - 1) :]


def env_refused(
    ctx: agentio.Context, payload: dict[str, Any], reply: Reply, scope: str = "up"
) -> agentio.Result:
    """A 422 is a refusal no grant limit describes (revision 17); a 403, a grant limit's envelope (exit 4)."""
    body = reply.body
    if reply.status == 422:
        setting, svc, value = str(body.get("setting", "?")), body.get("service"), body.get("value")
        where = f" (service {svc}: {value})" if svc else (f" ({value})" if value else "")
        if body.get("refusal") == "image" and setting == "FROM":
            # 014 FR-21: a build pulls nothing, so a base image not on the daemon is the operator's pull.
            raise agentio.ToolError(
                agentio.EXIT_NOT_FOUND,
                f"base image {value} is not on the daemon, and a build pulls nothing{where}",
                str(body.get("remediation", "the operator pulls it on the host")),
            )
        if setting == "devcontainer.json":
            # 014 FR-16: a devcontainer.json that does not parse is rule 14's usage error, naming the line.
            raise agentio.UsageError(
                f"devcontainer.json {value or 'does not parse'}",
                str(body.get("remediation") or "fix it, then run adele env up again"),
            )
        if body.get("refusal") == "image":
            # FOR-MENTOR Item 29: the grant envelope is false of a missing image; exit 3, provisional.
            raise agentio.ToolError(
                agentio.EXIT_NOT_FOUND,
                f"image {body.get('value')} is not on the daemon, and Adele never pulls{where}",
                str(body.get("remediation", "the operator pulls it on the host")),
            )
        # Rule 14's line (revision 17): error: <setting> is not allowed (code 2) — no grant allows it; …
        raise agentio.UsageError(
            f"{setting} is not allowed", f"{body.get('remediation', 'no grant allows it')}{where}"
        )
    limit, extend, grant = body.get("limit"), body.get("extend"), body.get("grant")
    if not isinstance(limit, dict) or not isinstance(extend, str) or not extend or not isinstance(grant, str):
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            "Adele refused the environment, but her answer does not name the grant, the limit and the"
            " operator's extend command",
            "nothing was created, as far as she said; ask the operator to check her ledger",
        )
    ledger_id = body.get("ledger_id")
    return agentio.grant_required(
        ctx,
        target="docker.compose",
        scope=scope,
        grant=grant,
        limit={k: str(limit.get(k)) for k in ("name", "allowed", "needed")},
        extend=extend,
        request=payload,
        ledger_id=ledger_id if isinstance(ledger_id, int) and not isinstance(ledger_id, bool) else None,
    )


def _probe(host: str, port: int) -> bool:
    import socket

    try:
        with socket.create_connection((host, port), timeout=ENV_PROBE_S):
            return True
    except OSError:
        return False


def readiness(svc: dict[str, Any]) -> tuple[str, str]:
    """(ready | completed | failed | waiting | unchecked, words) for one service, read back; ports probed from
    here. Decision C (014 plan R20): a running service with no healthcheck and no port gives no readiness
    signal, so it is "unchecked", never ready; a one-shot among them is waited for until it exits."""
    state, health = str(svc.get("state", "")), str(svc.get("health") or "")
    if state == "exited":
        code = svc.get("exit_code")
        return ("completed", "completed (exit 0)") if code == 0 else ("failed", f"exited {code}")
    if health:
        return ("ready", "ready (healthy)") if health == "healthy" else ("waiting", f"{state} ({health})")
    if state != "running":
        return "waiting", state or "not created"
    ports = svc.get("ports") or []
    if ports:
        closed = [p for p in ports if not _probe(str(svc.get("alias")), int(p))]
        if closed:
            return "waiting", "running, port " + ",".join(str(p) for p in closed) + " not accepting yet"
        return "ready", "ready (running, ports accept)"
    if svc.get("one_shot") is True:
        return "waiting", "running (one-shot: waiting for its exit)"
    return "unchecked", "running, no readiness check"


def _addresses(svc: dict[str, Any]) -> list[str]:
    return [f"{svc.get('alias')}:{p}" for p in svc.get("ports") or []]


def _service_line(svc: dict[str, Any], words: str) -> str:
    addr = " ".join(_addresses(svc))
    return f"{svc.get('service')}  {words}" + (f"  {addr}" if addr else "")


def env_up(args: argparse.Namespace, ctx: agentio.Context, ws: str) -> agentio.Result:
    if not math.isfinite(args.wait) or not 0 < args.wait <= ENV_WAIT_MAX_S:
        raise agentio.UsageError(
            f"--wait must be more than 0 and at most {ENV_WAIT_MAX_S:g}", "e.g. --wait 120"
        )
    if args.ttl is not None and not (_TTL_RE.match(args.ttl) and args.ttl):
        raise agentio.UsageError(f"--ttl {args.ttl!r} is not a duration like 30m or 1h", "use h and m")
    for f in args.file:
        if not f or os.path.isabs(f) or os.path.normpath(f).startswith(".."):
            raise agentio.UsageError(
                f"compose file {f!r} is not a path inside the project", "name it relative to DIR"
            )
    start = time.monotonic()
    deadline = start + args.wait
    directory = project_dir(args.action, ws)
    name = env_name(args, directory)
    payload = env_payload(args, "up", name, directory)
    reply = call("POST", "/v1/requests", max(1.0, deadline - time.monotonic()), payload)
    down = f"adele env down {name}"
    if reply.timed_out:
        raise agentio.ToolError(
            agentio.EXIT_TIMEOUT,
            f"Adele did not answer the bring-up of {name} within the {args.wait:g} s bound ({VANTAGE})",
            # Adele stops a request given up before she creates anything, and finishes and records one she has
            # started creating (lane 13s0a, item A); a down of the name waits for her bring-up of it.
            f"if she had started creating it she finishes and records it: adele env status {name}; {down}"
            " removes it once she is done; or raise --wait",
        )
    if reply.status == 0:
        raise unreachable(reply, args.timeout)
    if reply.status in (403, 422):
        return env_refused(ctx, payload, reply)
    if reply.status in (502, 504) and isinstance(reply.body.get("build"), dict):
        raise build_failed(name, reply)
    if reply.status != 200:
        raise answered_error(reply)
    body = reply.body
    lifecycle_failed(name, body)
    outcome = str(body.get("outcome"))
    services: list[dict[str, Any]] = [s for s in body.get("services") or [] if isinstance(s, dict)]
    states, how = await_ready(name, services, deadline)
    if how == "failed":
        s, _, words = next(st for st in states if st[1] == "failed")
        last = _last(s.get("last_lines"))
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"{name}: service {s.get('service')} {words}, read back from the daemon; it will not become"
            " ready" + (f" (last lines: {last})" if last else ""),
            f"look at the project's service; the environment is still up: {down}",
        )
    if how == "late":
        lines = [_service_line(s, words) for s, _, words in states]
        data = env_data(body, name, states, args.wait, time.monotonic() - start, ready=False)
        n_ready = sum(st[1] in ("ready", "completed") for st in states)
        return agentio.Result(
            "adele",
            "env up",
            f"up {name}: not ready within {args.wait:g} s ({n_ready} of {len(states)} ready, read back"
            f" from the daemon) — it stays up; remove it with {down}",
            lines=lines,
            data=data,
            exit=agentio.EXIT_TIMEOUT,
        )
    took = time.monotonic() - start
    lines = [_service_line(s, words) for s, _, words in states]
    lines += _up_extra_lines(body)
    unset = [str(u) for u in body.get("unset") or []]
    if unset:
        lines.append(
            "unset in the workspace: " + ", ".join(unset) + " — put them in the project's .env (the agent's"
            " environment is not read)"
        )
    lines.insert(
        0,
        f"grant {body.get('grant')} · expires {body.get('expires_at')} · local: no cost"
        f" · down: adele env down {name}",
    )
    if outcome == "unchanged":
        lines.insert(1, "unchanged: it was already up as asked; nothing created or recorded")
    return agentio.Result(
        "adele",
        "env up",
        up_verdict(name, body, states, took, args.wait),
        lines=lines,
        data=env_data(body, name, states, args.wait, took),
    )


State = tuple[dict[str, Any], str, str]  # a service, its readiness word, its words (readiness())


def await_ready(name: str, services: list[dict[str, Any]], deadline: float) -> tuple[list[State], str]:
    """Poll Adele's read-back of NAME until every service is ready, completed or unchecked ("ready"), one
    has failed ("failed"), or the deadline passes ("late"). `env up` and `env restore` both wait here, so a
    restore's readiness is up's exactly (014 FR-38, plan R27 step 7): read back, ports probed from here."""
    while True:
        states: list[State] = [(s, *readiness(s)) for s in services]
        if any(st[1] == "failed" for st in states):
            return states, "failed"
        if services and all(st[1] in ("ready", "completed", "unchecked") for st in states):
            return states, "ready"
        left = deadline - time.monotonic()
        if left <= 0:
            return states, "late"
        time.sleep(min(ENV_POLL_S, max(left, 0.0)))
        got = call("GET", f"/v1/envs/{name}", min(5.0, max(left, 0.5)))
        if got.status == 200 and isinstance(got.body.get("services"), list):
            services = [s for s in got.body["services"] if isinstance(s, dict)]


def probed(svc: dict[str, Any]) -> bool:
    """readiness() probed this service's ports: running, no healthcheck, ports named (014 plan R32 B)."""
    return str(svc.get("state", "")) == "running" and not svc.get("health") and bool(svc.get("ports"))


def _counts(states: list[State]) -> tuple[str, str]:
    """(long, short) readiness counts for a verdict. A service with no readiness signal is counted apart,
    never ready (decision C); its short form is the data's own word for it."""
    n_ready = sum(st[1] in ("ready", "completed") for st in states)
    n_unchecked = sum(st[1] == "unchecked" for st in states)
    long = [f"{n_ready} ready"] if n_ready or not n_unchecked else []
    short = list(long)
    if n_unchecked:
        long.append(f"{n_unchecked} running, no readiness check")
        short.append(f"{n_unchecked} unchecked")
    return ", ".join(long), ", ".join(short)


def _probe_clause(states: list[State]) -> str:
    """ ", ports probed from the agent container" when a port was probed, else nothing (014 FR-44, D22 B)."""
    return f", ports probed {VANTAGE}" if any(probed(s) for s, _, _ in states) else ""


def fit(parts: list[tuple[str, str]], order: list[int]) -> str:
    """A verdict of (long, short) parts, each long until the whole passes VERDICT_MAX; then the parts in
    `order` take their short form, one by one, until it fits (014 plan R32 A). What a short form leaves out
    is in the result's lines and data."""
    chosen = [long for long, _ in parts]
    for i in order:
        if len("".join(chosen)) <= VERDICT_MAX:
            break
        chosen[i] = parts[i][1]
    return "".join(chosen)


def up_verdict(name: str, body: dict[str, Any], states: list[State], took: float, wait: float) -> str:
    """up's verdict (014 plan R32): it fits rule 13's line at a 30-character name. "unchanged" leads, its
    meaning on the next line; "local: no cost" is on the grant's line; "ports probed" only when one was."""
    said = "unchanged, " if body.get("outcome") == "unchanged" else ""
    kind = "devcontainer, " if body.get("kind") == "devcontainer" else ""
    long, short = _counts(states)
    head = f"up {name}: {said}{kind}"
    tail = (
        f" in {took:.1f} s of {wait:g} s · read back{_probe_clause(states)}"
        f" · host git {body.get('host_git') or 'unknown'}"
    )
    return fit([(head, head), (long, short), (tail, tail)], [1])


def _entries(body: dict[str, Any], key: str) -> list[dict[str, Any]]:
    return [e for e in body.get(key) or [] if isinstance(e, dict)]


def build_failed(name: str, reply: Reply) -> agentio.ToolError:
    """014 FR-24: a build past its bound is 124 naming its step; a failed step is 1, with its last lines.
    The step is Adele's words for it, the instruction as the Dockerfile has it and its position there: never
    the daemon's "Step N/M", whose M counts the LABEL steps it adds for Adele's labels (lane 13s1a)."""
    build: dict[str, Any] = reply.body["build"]
    service, step = build.get("service"), build.get("step")
    remedy = str(reply.body.get("remediation") or "")
    if reply.status == 504 and reply.body.get("timed_out") is True:
        return agentio.ToolError(
            agentio.EXIT_TIMEOUT,
            f"{name}: build of {service} did not finish within its bound (at {step})",
            remedy or f"adele env status {name} shows what is up; adele env down {name} removes it",
        )
    raw_lines = build.get("last_lines")
    lines: list[Any] = raw_lines if isinstance(raw_lines, list) else []
    last = _last([*lines, build.get("message") or ""])
    return agentio.ToolError(
        agentio.EXIT_FAILURE,
        f"{name}: build of {service} failed at {step}" + (f": {last}" if last else ""),
        remedy or f"fix that step and run adele env up again; adele env down {name} removes what is up",
    )


def lifecycle_failed(name: str, body: dict[str, Any]) -> None:
    """014 FR-19: a lifecycle command past its bound is 124 and one that failed is 1, each naming the
    command. The environment is still a performed one, so it stays up and the remediation gives down."""
    down = f"the environment stays up; remove it with adele env down {name}"
    entries = _entries(body, "lifecycle")
    late = [e for e in entries if e.get("timed_out") is True]
    if late:
        raise agentio.ToolError(
            agentio.EXIT_TIMEOUT,
            f"{name}: lifecycle command {late[0].get('name')} did not finish within its bound",
            down,
        )
    bad = [e for e in entries if e.get("exit_code") != 0]
    if bad:
        e = bad[0]
        last = _last(e.get("last_lines"))
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"{name}: lifecycle command {e.get('name')} exited {e.get('exit_code')}"
            + (f" (last lines: {last})" if last else ""),
            down,
        )


def _up_extra_lines(body: dict[str, Any]) -> list[str]:
    """Slice 1's lines below the services: each build, each lifecycle command, what was not run, and a
    requester Adele could not find (014 plan R12, R13, R15, R18)."""
    lines: list[str] = []
    for b in _entries(body, "built"):
        if b.get("reused") is True:
            lines.append(f"reused {b.get('service')}: {b.get('image')} (unchanged)")
        else:
            secs = b.get("seconds")
            took = f"{secs:.1f}" if isinstance(secs, int | float) and not isinstance(secs, bool) else "?"
            lines.append(f"built {b.get('service')}: {b.get('image')} in {took} s (nothing pulled)")
    lines += [f"{e.get('name')}  exit {e.get('exit_code')}" for e in _entries(body, "lifecycle")]
    not_run = [str(n) for n in body.get("not_run") or []]
    if not_run:
        lines.append("not run: " + ", ".join(not_run))
    requester = body.get("requester")
    if isinstance(requester, dict) and "unknown" in requester:
        lines.append(
            f"requester: unknown ({requester.get('unknown')}) — only adele session end or the ttl can end it"
        )
    return lines


def env_data(
    body: dict[str, Any],
    name: str,
    states: list[State],
    wait: float,
    took: float,
    ready: bool = True,
) -> dict[str, Any]:
    return {
        "name": name,
        "outcome": body.get("outcome"),
        "ready": ready,
        "kind": body.get("kind"),
        "grant": body.get("grant"),
        "expires_at": body.get("expires_at"),
        "ledger_id": body.get("ledger_id"),
        "undo": body.get("undo"),
        "host_git": body.get("host_git"),
        "unset": body.get("unset") or [],
        "requester": body.get("requester"),
        "built": _entries(body, "built"),
        "lifecycle": _entries(body, "lifecycle"),
        "not_run": [str(n) for n in body.get("not_run") or []],
        "wait_s": wait,
        "seconds": round(took, 3),
        # Adele's own share, measured by her: the sandbox's phases, the lock, compose (lane 13s0a, item A).
        "adele_timings": body.get("timings"),
        "vantage": VANTAGE,
        "services": services_data(states),
    }


def services_data(states: list[State]) -> list[dict[str, Any]]:
    """Each service as `env up`'s data has it, its readiness word read back (and `env restore`'s)."""
    return [
        {
            **{k: s.get(k) for k in ("service", "state", "health", "exit_code", "alias", "ports")},
            "one_shot": s.get("one_shot") is True,
            "last_lines": [str(x) for x in s.get("last_lines") or []],
            "ready": st,
            "addresses": _addresses(s),
        }
        for s, st, _ in states
    ]


def env_down(name: str, timeout: float) -> agentio.Result:
    payload = {
        "session": agentio.session_id(),
        "grant": "",
        "capability": "docker.compose",
        "action": "down",
        "params": {"name": name, "ttl": "", "ports": []},
    }
    agent = agentio.agent_name()
    if agent is not None:
        payload["agent"] = agent
    reply = call("POST", "/v1/requests", max(timeout, 120.0), payload)
    if reply.status == 0:
        raise unreachable(reply, max(timeout, 120.0))
    if reply.status != 200:
        raise answered_error(reply)
    r = reply.body.get("removed") or {}
    verdict = (
        f"down {name}: removed {r.get('containers', 0)} containers, {r.get('networks', 0)} networks,"
        f" {r.get('volumes', 0)} volumes"
        + (f", {r['images']} images" if r.get("images") else "")
        + "; 0 left, read back from the daemon"  # built images (slice 1) only when there were any
    )
    return agentio.Result("adele", "env down", verdict, data={"name": name, **reply.body})


def env_status(name: str | None, timeout: float) -> agentio.Result:
    path = f"/v1/envs/{name}" if name else "/v1/envs"
    reply = call("GET", path, timeout)
    if reply.status == 0:
        raise unreachable(reply, timeout)
    if reply.status != 200:
        raise answered_error(reply)
    envs = [reply.body] if name else [e for e in reply.body.get("envs") or [] if isinstance(e, dict)]
    lines: list[str] = []
    for e in envs:
        lines.append(
            f"{e.get('name')}: expires {e.get('expires_at')} · grant {e.get('grant')}"
            f" · session {e.get('session')}"
        )
        for s in e.get("services") or []:
            words = f"{s.get('state')}" + (f" ({s.get('health')})" if s.get("health") else "")
            lines.append("  " + _service_line(s, words))
    verdict = f"{len(envs)} environment{'s' if len(envs) != 1 else ''} live (read back from the daemon)"
    return agentio.Result(
        "adele", "env status", verdict, lines=lines, data={"envs": envs, "count": len(envs)}
    )


# ── adele env exec, env collect, session end (feature 13, slice 1) ──────────────────────────────


def _caller() -> dict[str, Any]:
    """The session and, when set, the agent's name: who asks (attribution only, 004 slice 1)."""
    who: dict[str, Any] = {"session": agentio.session_id()}
    agent = agentio.agent_name()
    if agent is not None:
        who["agent"] = agent
    return who


def _exit_status(value: Any) -> int | None:
    ok = isinstance(value, int) and not isinstance(value, bool) and 0 <= value <= 255
    return value if ok else None


def _text_lines(value: Any) -> list[str]:
    return str(value).splitlines() if isinstance(value, str) and value else []


def env_exec(args: argparse.Namespace, ctx: agentio.Context) -> agentio.Result:
    """014 FR-25, plan R17: run a command in a running container of a live environment, through Adele, and
    exit with its own status, as 03's `run` does (Result.cause "command", command_exit)."""
    command = [str(c) for c in args.command or []]
    if not command:
        raise agentio.UsageError("env exec needs a command after --", "e.g. adele env exec -- ls -la")
    if args.action and _ENV_NAME_RE.match(args.action):
        name = args.action
    else:
        name = env_name(args, project_dir(args.action, workspace()))
    if args.service is not None and not args.service:
        raise agentio.UsageError("--service is empty", "name a service, e.g. --service web")
    bound = args.timeout
    params: dict[str, Any] = {"name": name, "ttl": "", "ports": []}
    if args.service:
        params["service"] = args.service
    params.update({"cmd": command, "timeout_s": bound})
    payload = {**_caller(), "grant": "", "capability": "docker.compose", "action": "exec", "params": params}
    down = f"adele env down {name}"
    started = time.monotonic()
    reply = call("POST", "/v1/requests", bound + EXEC_HTTP_SLACK_S, payload)
    took = time.monotonic() - started
    body = reply.body
    if reply.timed_out:
        raise agentio.ToolError(
            agentio.EXIT_TIMEOUT,
            f"Adele did not answer the exec in {name} within {bound + EXEC_HTTP_SLACK_S:g} s ({VANTAGE});"
            " the command may still be running in the container",
            f"the Engine API cannot stop an exec'd process; {down} removes the container",
        )
    if reply.status == 0:
        raise unreachable(reply, bound + EXEC_HTTP_SLACK_S)
    service = str(body.get("service") or args.service or "?")
    if reply.status == 504 and body.get("timed_out") is True:
        lines = _text_lines(body.get("stdout")) + _text_lines(body.get("stderr"))
        return agentio.Result(
            "adele",
            "env exec",
            f"exec {name} {service}: past its {bound:g} s bound; it may still be running in the container"
            f" (the Engine API cannot stop an exec'd process) · {down} removes it",
            lines=lines,
            data=_exec_data(name, service, command, bound, took, body),
            exit=agentio.EXIT_TIMEOUT,
            cause="timeout",
            command_exit=None,
        )
    if reply.status == 403:
        return env_refused(ctx, payload, reply, scope="exec")
    if reply.status == 404:
        raise agentio.ToolError(
            agentio.EXIT_NOT_FOUND,
            str(body.get("error") or f"no live environment {name}, or no container for its service"),
            str(body.get("remediation") or "adele env status lists the live environments and their services"),
        )
    if reply.status == 409:
        names = [str(s) for s in body.get("services") or []]
        raise agentio.UsageError(
            f"{name} has more than one service and none was named"
            + (f": {', '.join(names)}" if names else ""),
            f"name one with --service, e.g. --service {names[0] if names else 'web'}",
        )
    if reply.status == 502:
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            str(body.get("error") or f"the container of {service} in {name} is not running"),
            str(body.get("remediation") or f"adele env status {name} shows its state; {down} removes it"),
        )
    if reply.status != 200:
        raise answered_error(reply)
    code = _exit_status(body.get("exit_code"))
    if code is None:
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"Adele ran the command in {name} {service}, but her answer has no exit status"
            f" ({body.get('exit_code')!r})",
            "nothing is passed through as the command's; adele env status shows the environment",
        )
    user = str(body.get("user") or "") or "the image's user"
    verdict = f"exec {name} {service} as {user}: exit {code} in {took:.1f} s"
    raw_dropped = body.get("dropped")
    dropped: dict[str, Any] = raw_dropped if isinstance(raw_dropped, dict) else {}
    d_out, d_err = int(dropped.get("stdout") or 0), int(dropped.get("stderr") or 0)
    if d_out or d_err:
        verdict += (
            f" · dropped {d_out} bytes of stdout, {d_err} of stderr (Adele keeps the last 1 MiB of each)"
        )
    # agentio admits an exit outside its six only from a tool that declares passes_exit. adele declares it for
    # no other verb (it would change how every verb's argv is split, after parsing is done here), so it is
    # declared on this one result, after parsing: _emit_result is the only reader left.
    ctx.tool.passes_exit = True
    return agentio.Result(
        "adele",
        "env exec",
        verdict,
        lines=_text_lines(body.get("stdout")) + _text_lines(body.get("stderr")),
        data=_exec_data(name, service, command, bound, took, body),
        exit=code,
        cause="command",
        command_exit=code,
    )


def _exec_data(
    name: str, service: str, command: list[str], bound: float, took: float, body: dict[str, Any]
) -> dict[str, Any]:
    return {
        "name": name,
        "service": service,
        "user": body.get("user"),
        "cmd": command,
        "exit_code": body.get("exit_code"),
        "timed_out": body.get("timed_out") is True,
        "dropped": body.get("dropped"),
        "ledger_id": body.get("ledger_id"),
        "timeout_s": bound,
        "seconds": round(took, 3),
        "stdout_lines": len(_text_lines(body.get("stdout"))),
        "stderr_lines": len(_text_lines(body.get("stderr"))),
    }


def _removed(r: Any) -> str:
    if not isinstance(r, dict):
        return f"removed {r}"
    return (
        f"removed {r.get('containers', 0)} containers, {r.get('networks', 0)} networks,"
        f" {r.get('volumes', 0)} volumes" + (f", {r['images']} images" if r.get("images") else "")
    )


def _left(left: Any) -> str:
    if isinstance(left, list):
        return f"{len(left)} left" + (": " + ", ".join(str(x) for x in left) if left else "")
    if isinstance(left, dict):
        return "left: " + ", ".join(f"{v} {k}" for k, v in left.items())
    return f"{left} left"


def env_collect(timeout: float) -> agentio.Result:
    """014 FR-29, plan R19: one collection pass now, the reaper's own; each removal read back by Adele."""
    t = max(timeout, COLLECT_HTTP_S)
    reply = call("POST", "/v1/envs/collect", t, _caller())
    if reply.status == 0 and reply.timed_out:
        raise agentio.ToolError(
            agentio.EXIT_TIMEOUT,
            f"Adele at {base_url()} gave no answer to collect within {t:g} s ({VANTAGE}); her pass starts no"
            f" removal after {COLLECT_PASS_S:g} s, and what it leaves her reaper's next pass collects",
            "see what is still live with adele env status, or ask the operator whether Adele is running",
        )
    if reply.status == 0:
        raise unreachable(reply, t)
    if reply.status != 200:
        raise answered_error(reply)
    collected, failed = _entries(reply.body, "collected"), _entries(reply.body, "failed")
    said = "; ".join(f"{c.get('name')}: {c.get('cause')}" for c in collected)
    verdict = f"collect: {len(collected)} collected" + (f" ({said})" if said else "")
    verdict += f" · {len(failed)} failed"
    if failed:
        verdict += " (" + "; ".join(f"{f.get('name')}: {f.get('cause')}" for f in failed) + ")"
    verdict += " · read back from the daemon"
    by = " (recorded by another pass)"  # lane 13s2a: another reaper ended it first; the row is that reaper's
    lines = [
        f"collected {c.get('name')}: {c.get('cause')} · {_removed(c.get('removed'))}"
        f" · ledger #{c.get('ledger_id')}" + (by if c.get("already_recorded") else "")
        for c in collected
    ]
    lines += [
        f"failed {f.get('name')}: {f.get('cause')} · {_left(f.get('left'))} — tried again on the next pass"
        for f in failed
    ]
    data = {"collected": collected, "failed": failed, "count": len(collected)}
    return agentio.Result(
        "adele",
        "env collect",
        verdict,
        lines=lines,
        data=data,
        exit=agentio.EXIT_FAILURE if failed else agentio.EXIT_OK,
    )


def session(args: argparse.Namespace) -> agentio.Result:
    """014 FR-28, plan R19: `adele session end` ends the caller's own session with a ledger row, read back.
    A second one says it was already ended, and is exit 0."""
    if args.capability != "end" or args.action is not None:
        raise agentio.UsageError(
            f"session has no verb {' '.join(x for x in (args.capability, args.action) if x)!r}",
            "use adele session end",
        )
    reply = call("POST", "/v1/sessions/end", args.timeout, _caller())
    if reply.status == 0:
        raise unreachable(reply, args.timeout)
    if reply.status != 200:
        raise answered_error(reply)
    body = reply.body
    sid, at, row = body.get("session") or agentio.session_id(), body.get("ended_at"), body.get("ledger_id")
    outcome = body.get("outcome")
    if outcome == "ended":
        verdict = f"session {sid} ended at {at} (ledger #{row})"
    elif outcome == "already ended":
        verdict = f"session {sid} was already ended at {at} (ledger #{row}); nothing new recorded"
    else:
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"Adele answered session end with outcome {outcome!r}, neither ended nor already ended",
            "ask the operator to check her ledger: adeled ledger",
        )
    data = {"session": sid, "outcome": outcome, "ended_at": at, "ledger_id": row}
    return agentio.Result("adele", "session end", verdict, data=data)


# ── adele env snapshot, snapshots, restore, snapshot-rm (feature 13, slice 2) ───────────────────


def _int(value: Any) -> int | None:
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def _size(value: Any) -> str:
    """A measured size in binary units, as `run` prints it (`48.0 KiB`); `?` when Adele did not say."""
    n = _int(value)
    return agentio.size(n) if n is not None and n >= 0 else "?"


def _cap_size(value: Any) -> str:
    """A configured size: whole units when it is one (`1 GiB`, `64 KiB`), else as measured."""
    n = _int(value)
    if n is None or n < 0:
        return "?"
    for unit, k in (("GiB", 1 << 30), ("MiB", 1 << 20), ("KiB", 1 << 10)):
        if n >= k and n % k == 0:
            return f"{n // k} {unit}"
    return agentio.size(n)


def _plural(n: int, word: str) -> str:
    return f"{n} {word}" + ("" if n == 1 else "s")


def _seconds(ms: Any) -> float | None:
    n = _int(ms)
    return None if n is None or n < 0 else n / 1000


def _named(value: Any) -> list[str]:
    """Service names from a list of names, or of {"service": …} entries (snapshot's `paused`)."""
    out: list[str] = []
    for v in value if isinstance(value, list) else []:
        name = v.get("service") if isinstance(v, dict) else v
        if isinstance(name, str) and name:
            out.append(name)
    return out


def _dict(value: Any) -> dict[str, Any]:
    return value if isinstance(value, dict) else {}


def _cap_data(body: dict[str, Any]) -> dict[str, Any] | None:
    raw = body.get("cap")
    if not isinstance(raw, dict):
        return None
    return {k: raw.get(k) for k in ("bytes", "used", "left", "store")}


def _snapshot_record(snap: dict[str, Any], *keys: str) -> dict[str, Any]:
    return {k: snap.get(k) for k in keys}


SNAPSHOT_KEYS = ("id", "volume", "bytes", "files", "sockets", "digest", "taken_at", "note")
LISTED_KEYS = ("id", "volume", "bytes", "files", "digest", "taken_at", "note")


def _target_and(args: argparse.Namespace, verb: str, what: str) -> tuple[str, str]:
    """`adele env VERB [NAME] OPERAND`: (the environment, the operand). NAME is an environment's name, or
    a project DIR as for `down`; absent, it is the project directory's environment (or --project's)."""
    first, second = (args.action, args.operand) if args.operand is not None else (None, args.action)
    if not second:
        raise agentio.UsageError(f"env {verb} needs a {what}", f"e.g. adele env {verb} [NAME] {what}")
    if first and _ENV_NAME_RE.match(first):
        return first, second
    return env_name(args, project_dir(first, workspace())), second


def _snapshot_payload(args: argparse.Namespace, action: str, params: dict[str, Any]) -> dict[str, Any]:
    """Under the environment's own grant unless --grant names one (contract § Slice 2)."""
    who = _caller()
    return {
        **who,
        "grant": args.grant or "",
        "capability": "docker.compose",
        "action": action,
        "params": params,
    }


def _not_found(body: dict[str, Any], name: str) -> agentio.ToolError:
    """Exit 3 naming what does exist: the live environments, this one's volumes, or its snapshots (FR-32)."""
    what = str(body.get("error") or f"no environment named {name}")
    said = [str(body["remediation"])] if body.get("remediation") else []
    for key, label, none in (
        ("envs", "live environments", "no environment is live"),
        ("volumes", f"{name}'s volumes", f"{name} has no named volume"),
        ("snapshots", f"{name}'s snapshots", f"{name} has no snapshot"),
    ):
        listed = body.get(key)
        if isinstance(listed, list):
            names = [str(e.get("name") if isinstance(e, dict) else e) for e in listed]
            said.append(f"{label}: {', '.join(names)}" if names else none)
    return agentio.ToolError(agentio.EXIT_NOT_FOUND, what, "; ".join(said) or "adele env status lists them")


def _snapshot_failed(
    ctx: agentio.Context, payload: dict[str, Any], reply: Reply, name: str, bound: float
) -> agentio.Result:
    """Every answer but a 200, for the four slice-2 verbs (contract § Slice 2: 3, 4, 1, 124). A 403 is the
    grant envelope (the cap); everything else is raised."""
    action = str(payload.get("action"))
    body = reply.body
    if reply.timed_out:
        raise agentio.ToolError(
            agentio.EXIT_TIMEOUT,
            f"Adele did not answer env {action} of {name} within {bound:g} s ({VANTAGE})",
            f"she finishes and records what she started, and never leaves a service paused or stopped:"
            f" adele env snapshots {name}; adele env status {name}",
        )
    if reply.status == 0:
        raise unreachable(reply, bound)
    if reply.status == 403:
        return env_refused(ctx, payload, reply, scope=action)
    if reply.status == 404:
        raise _not_found(body, name)
    if reply.status in (502, 504):
        raise _snapshot_error(action, name, payload, reply)
    raise answered_error(reply)


def _snapshot_error(action: str, name: str, payload: dict[str, Any], reply: Reply) -> agentio.ToolError:
    """502 and 504: the cause, then what Adele says she undid and what is left (FR-39, R27, R28)."""
    body = reply.body
    params = _dict(payload.get("params"))
    cause = str(body.get("error") or f"Adele answered HTTP {reply.status}")
    late = reply.status == 504 or body.get("timed_out") is True
    said: list[str] = []
    if action == "snapshot":
        if body.get("partial_removed") is True:
            said.append("the partial snapshot was removed, read back gone")
        elif body.get("partial_removed") is False:
            said.append("the partial snapshot is still there (Adele's next pass removes it)")
        if _named(body.get("unpaused")):
            said.append(f"unpaused {', '.join(_named(body.get('unpaused')))}, read back running")
        if _named(body.get("still_paused")):
            said.append(f"still paused: {', '.join(_named(body.get('still_paused')))}")
        what = f"env snapshot of {params.get('volume')} in {name} failed: {cause}"
        remedy = f"nothing was kept; adele env snapshots {name} lists what there is"
        if _named(body.get("still_paused")):
            remedy = f"Adele unpauses them on her next pass; adele env status {name} shows them"
    elif action == "restore":
        snap = params.get("snapshot")
        if body.get("partial") is True:
            said.append("the volume's contents are partial")
            if _named(body.get("started")):
                said.append(f"started again: {', '.join(_named(body.get('started')))}")
            remedy = f"run adele env restore {name} {snap} --yes again, or adele env down {name}"
        else:
            if body.get("stopped") == []:
                said.append("nothing was stopped or changed")
            remedy = f"adele env snapshots {name} lists its snapshots; adele env status {name} its services"
        what = f"env restore of {name} from {snap} failed: {cause}"
    else:
        what = f"env {action} of {name} failed: {cause}"
        remedy = f"adele env snapshots {name} lists what there is"
    if said:
        what += " (" + "; ".join(said) + ")"
    remedy = str(body.get("remediation") or remedy)
    return agentio.ToolError(agentio.EXIT_TIMEOUT if late else agentio.EXIT_FAILURE, what, remedy)


def env_snapshot(args: argparse.Namespace, ctx: agentio.Context) -> agentio.Result:
    """014 FR-31, FR-35, plan R26: one named volume, copied with its users paused, the copy's digest read
    back equal to the source's. Over the grant's cap: the grant envelope, nothing written (FR-34)."""
    name, volume = _target_and(args, "snapshot", "VOLUME")
    note = args.note or ""
    if len(note) > NOTE_MAX:
        raise agentio.UsageError(f"--note is {len(note)} characters; at most {NOTE_MAX}", "shorten it")
    payload = _snapshot_payload(args, "snapshot", {"name": name, "volume": volume, "note": note})
    bound = max(args.timeout, SNAPSHOT_HTTP_S)
    reply = call("POST", "/v1/requests", bound, payload)
    if reply.status != 200:
        return _snapshot_failed(ctx, payload, reply, name, bound)
    body = reply.body
    snap = _dict(body.get("snapshot"))
    if body.get("outcome") != "performed" or not snap.get("id"):
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"Adele answered the snapshot of {volume} in {name} with outcome {body.get('outcome')!r} and no"
            " snapshot id",
            f"adele env snapshots {name} lists what was kept",
        )
    sid, vol = str(snap["id"]), str(snap.get("volume") or volume)
    files, sockets = _int(snap.get("files")), _int(snap.get("sockets")) or 0
    head = f"snapshot {name} {vol}: {sid}, {_size(snap.get('bytes'))}"
    head += f", {_plural(files, 'file')}" if files is not None else ""
    head += f", {_plural(sockets, 'socket')} not copied" if sockets else ""
    paused, paused_s = _named(body.get("paused")), _seconds(body.get("paused_ms"))
    took = f" for {paused_s:.1f} s" if paused_s is not None else ""
    parts = [(head, head)]
    if paused:  # said only when something was paused (each clause says what was done)
        parts.append((f" · paused {', '.join(paused)}{took}", f" · paused {len(paused)}{took}"))
    cap = _cap_data(body)
    if cap is not None and _int(cap.get("bytes")) is not None and _int(cap.get("left")) is not None:
        said = f" · cap {_cap_size(cap['bytes'])}, {_size(cap['left'])} left"
        parts.append((said, said))
    verdict = fit(parts, [1] if paused else [])
    lines = []
    if paused:
        lines.append(f"paused {', '.join(paused)}{took}, then unpaused, read back running")
    lines.append(f"digest {snap.get('digest')}: the copy's, read back equal to the source's")
    if note:
        lines.append(f"note: {note}")
    lines.append(
        f"restore it: adele env restore {name} {sid} --yes · remove it: adele env snapshot-rm {name} {sid}"
    )
    data = {
        "name": name,
        "snapshot": _snapshot_record(snap, *SNAPSHOT_KEYS),
        "paused": paused,
        "paused_s": paused_s,
        "cap": cap,
        "ledger_id": body.get("ledger_id"),
    }
    return agentio.Result("adele", "env snapshot", verdict, lines=lines, data=data)


def _list_snapshots(
    args: argparse.Namespace, ctx: agentio.Context, name: str
) -> tuple[agentio.Result | None, dict[str, Any]]:
    """(a 403's envelope, or None; the snapshots answer). Raises on every other failure."""
    payload = _snapshot_payload(args, "snapshots", {"name": name})
    reply = call("POST", "/v1/requests", args.timeout, payload)
    if reply.status != 200:
        return _snapshot_failed(ctx, payload, reply, name, args.timeout), {}
    return None, reply.body


def env_snapshots(args: argparse.Namespace, ctx: agentio.Context) -> agentio.Result:
    """014 FR-31: this environment's snapshots, newest first, with the cap used and left. Nothing written."""
    if args.action and _ENV_NAME_RE.match(args.action):
        name = args.action
    else:
        name = env_name(args, project_dir(args.action, workspace()))
    refused_, body = _list_snapshots(args, ctx, name)
    if refused_ is not None:
        return refused_
    items = _entries(body, "snapshots")
    volumes = [str(v) for v in body.get("volumes") or []]
    cap = _cap_data(body)
    lines = [
        f"{e.get('id')}  {e.get('volume')}  {_size(e.get('bytes'))}"
        f"  {_plural(_int(e.get('files')) or 0, 'file')}  {e.get('taken_at')}"
        + (f"  {e.get('note')}" if e.get("note") else "")
        for e in items
    ]
    lines.append(f"volumes: {', '.join(volumes)}" if volumes else f"volumes: {name} has no named volume")
    verdict = f"snapshots {name}: {len(items)}"
    if cap is not None and _int(cap.get("bytes")) is not None and _int(cap.get("used")) is not None:
        verdict += f" · {_size(cap['used'])} of {_cap_size(cap['bytes'])} used"
        if _int(cap.get("left")) is not None:
            store = f" (store: {cap.get('store')})" if cap.get("store") else ""
            lines.append(f"cap {_cap_size(cap['bytes'])}: {_size(cap['left'])} left{store}")
    data = {
        "name": name,
        "snapshots": [_snapshot_record(e, *LISTED_KEYS) for e in items],
        "cap": cap,
        "volumes": volumes,
    }
    return agentio.Result("adele", "env snapshots", verdict, lines=lines, data=data)


def env_restore(args: argparse.Namespace, ctx: agentio.Context) -> agentio.Result:
    """014 FR-38, plan R27: rule 9's confirm protocol, then Adele's restore, then up's readiness wait."""
    if not math.isfinite(args.wait) or not 0 < args.wait <= ENV_WAIT_MAX_S:
        raise agentio.UsageError(
            f"--wait must be more than 0 and at most {ENV_WAIT_MAX_S:g}", "e.g. --wait 120"
        )
    name, sid = _target_and(args, "restore", "SNAPSHOT")
    if args.dry_run or not args.yes:
        return _restore_plan(args, ctx, name, sid)
    payload = _snapshot_payload(args, "restore", {"name": name, "snapshot": sid, "dry_run": False})
    bound = max(args.timeout, SNAPSHOT_HTTP_S)
    reply = call("POST", "/v1/requests", bound, payload)
    if reply.status != 200:
        return _snapshot_failed(ctx, payload, reply, name, bound)
    body = reply.body
    snap = _dict(body.get("snapshot"))
    vol = str(body.get("volume") or snap.get("volume") or "?")
    if body.get("outcome") != "performed":
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"Adele answered the restore of {name} from {sid} with outcome {body.get('outcome')!r}",
            f"adele env status {name} shows its services; adele env snapshots {name} its snapshots",
        )
    digest, recorded = body.get("digest"), snap.get("digest")
    if not digest or (recorded and digest != recorded):
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"{name}: Adele answered restored from {sid}, but the digest she read back ({digest!r}) is not"
            f" the snapshot's record ({recorded!r})",
            f"the volume's contents are not known to be the snapshot's: run adele env restore {name} {sid}"
            f" --yes again, or adele env down {name}",
        )
    stopped, stopped_s = _named(body.get("stopped")), _seconds(body.get("stopped_ms"))
    services = [s for s in body.get("services") or [] if isinstance(s, dict)]
    start = time.monotonic()
    states, how = await_ready(name, services, start + args.wait)
    took = time.monotonic() - start
    after = f"the data stays restored; adele env status {name} shows it, adele env down {name} removes it"
    lines = [_service_line(s, words) for s, _, words in states]
    if stopped:
        secs = f" for {stopped_s:.1f} s" if stopped_s is not None else ""
        lines.append(f"stopped {', '.join(stopped)}{secs}, then started again (read back by Adele)")
    lines.append(
        f"digest {digest}: the volume's, read back equal to {sid}'s record · ledger #{body.get('ledger_id')}"
    )
    data = {
        "name": name,
        "snapshot": sid,
        "volume": vol,
        "stopped": stopped,
        "stopped_s": stopped_s,
        "digest": digest,
        "services": services_data(states),
        "ready": how == "ready",
        "wait_s": args.wait,
        "seconds": round(took, 3),
        "adele_readiness": body.get("adele_readiness"),
        "ledger_id": body.get("ledger_id"),
        "vantage": VANTAGE,
        "dry_run": False,
    }
    head = f"restore {name} {vol} from {sid}: digest read back"
    if how == "failed":
        s, _, words = next(st for st in states if st[1] == "failed")
        last = _last(s.get("last_lines"))
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"{head}; service {s.get('service')} {words}, read back from the daemon; it will not become ready"
            + (f" (last lines: {last})" if last else ""),
            after,
        )
    if how == "late":
        n_ready = sum(st[1] in ("ready", "completed") for st in states)
        return agentio.Result(
            "adele",
            "env restore",
            f"{head} · not ready within {args.wait:g} s ({n_ready} of {len(states)} ready, read back);"
            " the data stays restored",
            lines=[*lines, f"next: adele env status {name} shows it · adele env down {name} removes it"],
            data={**data, "ready": False},
            exit=agentio.EXIT_FAILURE,
            footer=1,  # the commands, never cut
        )
    long, short = _counts(states)
    parts = [(head, head)]
    if stopped:  # said only when something was stopped
        secs = f" for {stopped_s:.1f} s" if stopped_s is not None else ""
        parts.append((f" · stopped {', '.join(stopped)}{secs}", f" · stopped {len(stopped)}"))
    parts.append((f" · {long}", f" · {short}"))
    tail = f" in {took:.1f} s of {args.wait:g} s" + (
        f" · ports probed {VANTAGE}" if _probe_clause(states) else ""
    )
    parts.append((tail, tail))
    order = [1, 2] if stopped else [1]
    return agentio.Result("adele", "env restore", fit(parts, order), lines=lines, data=data)


def _restore_plan(args: argparse.Namespace, ctx: agentio.Context, name: str, sid: str) -> agentio.Result:
    """Rule 8 and rule 9 (FR-38): Adele's plan, `dry_run: true`, which stops and writes nothing. With
    --dry-run it is printed (exit 0); without --yes it is the confirmation envelope's plan (exit 4)."""
    payload = _snapshot_payload(args, "restore", {"name": name, "snapshot": sid, "dry_run": True})
    reply = call("POST", "/v1/requests", args.timeout, payload)
    if reply.status != 200:
        return _snapshot_failed(ctx, payload, reply, name, args.timeout)
    body = reply.body
    if body.get("outcome") != "plan":
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"Adele answered a restore's plan with outcome {body.get('outcome')!r}, not a plan",
            f"nothing is confirmed on her word; adele env status {name} shows the environment",
        )
    snap = _dict(body.get("snapshot"))
    vol = str(body.get("volume") or snap.get("volume") or "?")
    stop = _named(body.get("stop"))
    stopping = f"stop {', '.join(stop)}" if stop else "stop nothing (no running service mounts it)"
    files = _int(snap.get("files"))
    plan = [
        f"replace volume {vol} of {name} with {sid}; {stopping}",  # rule 14's line quotes it whole
        f"snapshot {sid}: {_size(snap.get('bytes'))}"
        + (f", {_plural(files, 'file')}" if files is not None else "")
        + f", taken {snap.get('taken_at')}"
        + (f", note: {snap.get('note')}" if snap.get("note") else ""),
    ]
    if stop:
        plan.append(
            f"then start {', '.join(stop)} again and wait for readiness (within --wait {args.wait:g} s)"
        )
    plan.append(
        f"the volume's present contents are not kept: adele env snapshot {name} {vol} first, if they matter"
    )
    if not args.dry_run:
        return agentio.confirm_required(ctx, target="docker.compose", scope="env restore", plan=plan)
    would = f"would stop {', '.join(stop)}" if stop else "would stop nothing"
    head = f"restore {name} {vol} from {sid}: dry run, nothing changed"
    return agentio.Result(
        "adele",
        "env restore",
        fit([(head, head), (f" · {would}", f" · would stop {len(stop)}")], [1]),
        lines=plan,
        data={"name": name, "snapshot": sid, "volume": vol, "stop": stop, "dry_run": True},
    )


def env_snapshot_rm(args: argparse.Namespace, ctx: agentio.Context) -> agentio.Result:
    """014 FR-31: remove one snapshot, freeing cap space. It deletes the only copy of a past state, rule 9's
    own case (plan R31): without --yes, exit 4 naming the snapshot and its size (read from `snapshots`)."""
    name, sid = _target_and(args, "snapshot-rm", "SNAPSHOT")
    if args.dry_run or not args.yes:
        refused_, body = _list_snapshots(args, ctx, name)
        if refused_ is not None:
            return refused_
        items = _entries(body, "snapshots")
        found = next((e for e in items if e.get("id") == sid), None)
        if found is None:
            raise _not_found(
                {"error": f"no snapshot {sid} in {name}", "snapshots": [e.get("id") for e in items]}, name
            )
        plan = [
            f"remove snapshot {sid} of {found.get('volume')} ({_size(found.get('bytes'))}, taken"
            f" {found.get('taken_at')}): the only copy of that state",
        ]
        if found.get("note"):
            plan.append(f"its note: {found.get('note')}")
        if not args.dry_run:
            return agentio.confirm_required(ctx, target="docker.compose", scope="env snapshot-rm", plan=plan)
        return agentio.Result(
            "adele",
            "env snapshot-rm",
            f"snapshot-rm {name} {sid}: dry run, nothing removed · would free {_size(found.get('bytes'))}",
            lines=plan,
            data={
                "name": name,
                "snapshot": sid,
                "volume": found.get("volume"),
                "bytes": found.get("bytes"),
                "dry_run": True,
            },
        )
    payload = _snapshot_payload(args, "snapshot-rm", {"name": name, "snapshot": sid})
    bound = max(args.timeout, SNAPSHOT_RM_HTTP_S)
    reply = call("POST", "/v1/requests", bound, payload)
    if reply.status != 200:
        return _snapshot_failed(ctx, payload, reply, name, bound)
    body = reply.body
    if body.get("outcome") != "removed":
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"Adele answered the removal of {sid} in {name} with outcome {body.get('outcome')!r}",
            f"adele env snapshots {name} lists what is there",
        )
    cap = _cap_data(body)
    lines = [f"ledger #{body.get('ledger_id')}"]
    if cap is not None and _int(cap.get("left")) is not None:
        lines.insert(0, f"cap {_cap_size(cap.get('bytes'))}: {_size(cap.get('left'))} left")
    return agentio.Result(
        "adele",
        "env snapshot-rm",
        f"snapshot-rm {name} {sid}: removed, read back · {_size(body.get('bytes'))} freed",
        lines=lines,
        data={
            "name": name,
            "snapshot": sid,
            "freed_bytes": body.get("bytes"),
            "cap": cap,
            "ledger_id": body.get("ledger_id"),
        },
    )


if __name__ == "__main__":
    agentio.run(TOOL, main, configure=configure)
