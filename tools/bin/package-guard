#!/opt/timelike/python/bin/python3 -I
"""package-guard — check each package an install names before the installer runs (feature 013, prompt 15).

`package-guard [--yes] [--dry-run] -- CMD [ARG...]` reads CMD as an install (pip, `python -m pip`, uv, npm,
npx, pnpm) and checks every package it names, in the registry the installer itself would use:

- **exists**: a name the registry says it does not have is refused, naming the package and the registry;
- **old enough**: a release younger than TIMELIKE_PACKAGE_MIN_AGE_DAYS (default 2) is refused, naming the
  release date the registry gives;
- **pinned**: a package the project's lockfile already pins passes with no registry request at all.

A refusal is the output contract's exit-4 `confirmation_required` envelope, and CMD never starts, so nothing
is downloaded. Its `confirm` is `package-guard --yes -- CMD`, which proceeds and records the override in the
session: the event line carries an `override` field, and its `ref` points at the record. A registry that
does not answer is never called absent: the refusal says it was unreachable from here, and how. When every
check passes, CMD runs through `run` (every call concludes) and its exit is the tool's. A command that
installs nothing runs unchanged, unchecked.

The bare commands reach it through /opt/timelike/shims (FOR-MENTOR Item 24, Q1 (b')): a wrapper named pip,
pip3, uv, npm, npx or pnpm, first on PATH, calls `package-guard --gate -- NAME ARG...` for anything that may
be an install. `--gate` checks and runs nothing: on a pass (exit 0) the wrapper drops the guard's output and
execs the real command itself, so its output and exit are the installer's own; a refusal is the envelope.
`python -m pip`, a venv's own pip and /usr/local/bin/pip are not reached (slice 2's proxy closes them).

Design: .specswarm/features/013-package-guard/ (spec, research R1-R11, data-model.md,
contracts/package-guard-cli.md).
"""

from __future__ import annotations

import argparse
import configparser
import datetime as dt
import functools
import html.parser
import http.client
import json
import os
import queue
import re
import shlex
import shutil
import socket
import ssl
import subprocess
import threading
import time
import tomllib
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Callable, Iterable, Iterator, Sequence
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

import agentio

MIN_AGE_ENV = "TIMELIKE_PACKAGE_MIN_AGE_DAYS"
DEFAULT_MIN_AGE_DAYS = 2.0  # spec D-7
TIMEOUT_ENV = "TIMELIKE_PACKAGE_TIMEOUT"
DEFAULT_TIMEOUT_S = 10.0  # research R8
MAX_BODY = 64 << 20  # FR-17: a larger answer is unreadable, never half-read
MAX_WORKERS = 8
PYPI_DEFAULT = "https://pypi.org/simple"
NPM_DEFAULT = "https://registry.npmjs.org/"
PEP691 = "application/vnd.pypi.simple.v1+json"
SIMPLE_ACCEPT = f"{PEP691}, application/vnd.pypi.simple.v1+html;q=0.2, text/html;q=0.01"
REVISION_FILE = "/opt/timelike/REVISION"
RECORD_DIR = "package-guard"
SHIMS_ENV = "TIMELIKE_SHIMS"  # the wrappers' directory, never searched for CMD (no recursion, P002)
DEFAULT_SHIMS = "/opt/timelike/shims"

PY_LOCKS = ("uv.lock", "pylock.toml")
NODE_LOCKS = ("package-lock.json", "npm-shrinkwrap.json", "pnpm-lock.yaml")
OK_RESULTS = frozenset({"ok", "pinned", "unchecked"})


def revision() -> str:
    try:
        return Path(REVISION_FILE).read_text(encoding="utf-8").strip() or "unknown"
    except OSError:
        return "dev"


def user_agent() -> str:
    """Every lookup names itself (research R7), so a registry's log tells the guard's requests apart."""
    return f"timelike-package-guard/{revision()}"


# ── versions: PEP 440 (research R4) ─────────────────────────────────────────────────────────────

_PEP440 = re.compile(
    r"""^\s*v?
    (?:(?P<epoch>\d+)!)?
    (?P<release>\d+(?:\.\d+)*)
    (?:[-_.]?(?P<pre_l>alpha|beta|preview|pre|a|b|c|rc)[-_.]?(?P<pre_n>\d+)?)?
    (?:(?:-(?P<post_n1>\d+))|(?:[-_.]?(?P<post_l>post|rev|r)[-_.]?(?P<post_n2>\d+)?))?
    (?:[-_.]?(?P<dev_l>dev)[-_.]?(?P<dev_n>\d+)?)?
    (?:\+(?P<local>[a-z0-9]+(?:[-_.][a-z0-9]+)*))?
    \s*$""",
    re.IGNORECASE | re.VERBOSE,
)
_PRE_ORDER = {"a": 0, "alpha": 0, "b": 1, "beta": 1, "c": 2, "rc": 2, "pre": 2, "preview": 2}


@dataclass(frozen=True)
class PyVersion:
    text: str
    epoch: int
    release: tuple[int, ...]
    pre: tuple[int, int] | None
    post: int | None
    dev: int | None
    local: tuple[tuple[int, int, str], ...] | None

    @property
    def is_pre(self) -> bool:
        return self.pre is not None or self.dev is not None

    def key(self, with_local: bool = True) -> tuple[Any, ...]:
        rel = list(self.release)
        while len(rel) > 1 and rel[-1] == 0:
            rel.pop()
        if self.pre is None and self.post is None and self.dev is not None:
            pre: tuple[int, ...] = (0,)
        elif self.pre is None:
            pre = (2,)
        else:
            pre = (1, *self.pre)
        post = (0,) if self.post is None else (1, self.post)
        dev = (1,) if self.dev is None else (0, self.dev)
        local = (0,) if (self.local is None or not with_local) else (1, self.local)
        return (self.epoch, tuple(rel), pre, post, dev, local)

    def public(self) -> tuple[Any, ...]:
        return self.key(with_local=False)


def py_version(text: str) -> PyVersion | None:
    m = _PEP440.match(text)
    if not m:
        return None
    pre = None
    if m.group("pre_l"):
        pre = (_PRE_ORDER[m.group("pre_l").lower()], int(m.group("pre_n") or 0))
    post = None
    if m.group("post_n1") is not None:
        post = int(m.group("post_n1"))
    elif m.group("post_l"):
        post = int(m.group("post_n2") or 0)
    dev = int(m.group("dev_n") or 0) if m.group("dev_l") else None
    local = None
    if m.group("local"):
        local = tuple(
            (1, int(s), "") if s.isdigit() else (0, 0, s.lower())
            for s in re.split(r"[-_.]", m.group("local"))
        )
    return PyVersion(
        text=text.strip(),
        epoch=int(m.group("epoch") or 0),
        release=tuple(int(x) for x in m.group("release").split(".")),
        pre=pre,
        post=post,
        dev=dev,
        local=local,
    )


_PY_SPEC = re.compile(r"^\s*(~=|===|==|!=|<=|>=|<|>)\s*([^\s,;]+)\s*$")


class SpecError(ValueError):
    """A version, range or specifier that does not parse (FR-9)."""


@dataclass(frozen=True)
class PySpec:
    op: str
    text: str
    version: PyVersion | None  # None only for === and a prefix match
    prefix: tuple[int, ...] | None  # ==1.2.* / !=1.2.*

    def admits(self, v: PyVersion) -> bool:
        if self.op == "===" or self.version is None:
            return v.text.lower() == self.text.lower()
        if self.prefix is not None:
            n = len(self.prefix)
            padded = (v.release + (0,) * n)[:n]
            hit = v.epoch == self.version.epoch and padded == self.prefix
            return hit if self.op == "==" else not hit
        s = self.version
        if self.op in ("==", "!="):
            same = v.key(with_local=s.local is not None) == s.key()
            return same if self.op == "==" else not same
        if self.op == "~=":
            prefix = s.release[:-1]
            padded = (v.release + (0,) * len(prefix))[: len(prefix)]
            return v.public() >= s.public() and v.epoch == s.epoch and padded == prefix
        if self.op == "<=":
            return v.public() <= s.public()
        if self.op == ">=":
            return v.public() >= s.public()
        same_base = v.epoch == s.epoch and _trim(v.release) == _trim(s.release)
        if self.op == "<":
            return v.public() < s.public() and (s.is_pre or not (v.is_pre and same_base))
        # ">": not a post-release of the bound unless it is one, and not a local version of it
        if not v.public() > s.public():
            return False
        if v.post is not None and s.post is None and same_base and v.pre is None and s.pre is None:
            return False
        return not (v.local is not None and v.public() == s.public())

    @property
    def mentions_pre(self) -> bool:
        return self.version is not None and self.version.is_pre


def _trim(rel: tuple[int, ...]) -> tuple[int, ...]:
    r = list(rel)
    while len(r) > 1 and r[-1] == 0:
        r.pop()
    return tuple(r)


def py_specifier(text: str) -> list[PySpec]:
    """`>=1.0, <2`, `==1.2.*`, `~=1.4.2`, `===odd`; an empty string admits every version."""
    text = text.strip()
    if text.startswith("(") and text.endswith(")"):
        text = text[1:-1]
    out: list[PySpec] = []
    for part in [p for p in text.split(",") if p.strip()]:
        m = _PY_SPEC.match(part)
        if not m:
            raise SpecError(f"cannot read the version specifier {part.strip()!r}")
        op, ver = m.groups()
        if op == "===":
            out.append(PySpec(op, ver, None, None))
            continue
        prefix = None
        if ver.endswith(".*"):
            if op not in ("==", "!="):
                raise SpecError(f"{op}{ver}: a wildcard is allowed only with == and !=")
            v = py_version(ver[:-2])
            if v is None:
                raise SpecError(f"cannot read the version {ver!r}")
            prefix = v.release
        else:
            v = py_version(ver)
            if v is None:
                raise SpecError(f"cannot read the version {ver!r}")
            if op == "~=" and len(v.release) < 2:
                raise SpecError(f"~={ver} needs at least two release numbers")
        out.append(PySpec(op, ver, v, prefix))
    return out


def py_select(
    versions: dict[str, Release], specs: list[PySpec], allow_pre: bool
) -> tuple[list[tuple[PyVersion, Release]], bool]:
    """The releases pip could pick, newest first, and whether pre-releases were let in.

    pip's rules (FR-15): yanked files are ignored unless pinned exactly (PEP 592); pre-releases only when
    asked
    (`--pre`, or a specifier that names one), or when nothing else matches.
    """
    exact = any(s.op in ("==", "===") and s.prefix is None for s in specs)
    parsed: list[tuple[PyVersion, Release]] = []
    for text, rel in versions.items():
        v = py_version(text)
        if v is None or (rel.yanked and not exact):
            continue
        if all(s.admits(v) for s in specs):
            parsed.append((v, rel))
    parsed.sort(key=lambda p: p[0].key(), reverse=True)
    pre_ok = allow_pre or any(s.mentions_pre for s in specs)
    finals = [p for p in parsed if not p[0].is_pre]
    if pre_ok or not finals:
        return parsed, True
    return finals, False


# ── versions: npm semver (research R4; node-semver's grammar) ───────────────────────────────────

_SEMVER = re.compile(
    r"^\s*[v=]?\s*(\d+)\.(\d+)\.(\d+)(?:-([0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*))?(?:\+[0-9A-Za-z.-]+)?\s*$"
)
_PARTIAL = re.compile(
    r"^[v=]?\s*([0-9]+|[xX*])(?:\.([0-9]+|[xX*])(?:\.([0-9]+|[xX*])(?:-([0-9A-Za-z.-]+))?(?:\+[0-9A-Za-z.-]+)?)?)?$"
)


@dataclass(frozen=True)
class NpmVersion:
    major: int
    minor: int
    patch: int
    pre: tuple[str | int, ...]

    def triple(self) -> tuple[int, int, int]:
        return (self.major, self.minor, self.patch)

    def key(self) -> tuple[Any, ...]:
        if not self.pre:
            return (self.triple(), (1,))
        ids = tuple((0, x, "") if isinstance(x, int) else (1, 0, x) for x in self.pre)
        return (self.triple(), (0, ids))

    def __str__(self) -> str:
        base = f"{self.major}.{self.minor}.{self.patch}"
        return base + ("-" + ".".join(str(x) for x in self.pre) if self.pre else "")


def _pre_ids(text: str | None) -> tuple[str | int, ...]:
    if not text:
        return ()
    return tuple(int(x) if x.isdigit() else x for x in text.split("."))


def npm_version(text: str) -> NpmVersion | None:
    m = _SEMVER.match(text)
    if not m:
        return None
    return NpmVersion(int(m.group(1)), int(m.group(2)), int(m.group(3)), _pre_ids(m.group(4)))


Comparator = tuple[str, NpmVersion]  # op in < <= > >= =
_ZERO = NpmVersion(0, 0, 0, ())


def _lower(major: int, minor: int, patch: int) -> NpmVersion:
    return NpmVersion(major, minor, patch, ())


def _upper(major: int, minor: int, patch: int) -> NpmVersion:
    return NpmVersion(major, minor, patch, (0,))  # `<X.Y.Z-0`: below every pre-release of X.Y.Z


def _partial(text: str) -> tuple[int | None, int | None, int | None, tuple[str | int, ...]]:
    m = _PARTIAL.match(text.strip())
    if not m:
        raise SpecError(f"cannot read the version range {text!r}")

    def num(x: str | None) -> int | None:
        return None if x is None or x in ("x", "X", "*") else int(x)

    return num(m.group(1)), num(m.group(2)), num(m.group(3)), _pre_ids(m.group(4))


def _comparators(part: str) -> list[Comparator]:
    """One comparator token (`^1.2`, `~1`, `>=1.2.3`, `1.x`) as plain comparators (node-semver's
    desugaring)."""
    if part in ("", "*", "x", "X"):
        return []
    if part.startswith("^"):
        ma, mi, pa, pre = _partial(part[1:])
        if ma is None:
            return []
        lo = NpmVersion(ma, mi or 0, pa or 0, pre)
        if ma > 0 or mi is None:
            hi = _upper(ma + 1, 0, 0)
        elif mi > 0 or pa is None:
            hi = _upper(0, mi + 1, 0)
        else:
            hi = _upper(0, 0, pa + 1)
        return [(">=", lo), ("<", hi)]
    if part.startswith("~"):
        ma, mi, pa, pre = _partial(part[1:].lstrip(">"))
        if ma is None:
            return []
        lo = NpmVersion(ma, mi or 0, pa or 0, pre)
        hi = _upper(ma + 1, 0, 0) if mi is None else _upper(ma, mi + 1, 0)
        return [(">=", lo), ("<", hi)]
    m = re.match(r"^(<=|>=|<|>|=)?\s*(.+)$", part)
    if m is None:
        raise SpecError(f"cannot read the version range {part!r}")
    op, rest = m.group(1) or "", m.group(2)
    ma, mi, pa, pre = _partial(rest)
    if ma is None:
        return [("<", _ZERO)] if op in ("<", ">") else []
    if mi is not None and pa is not None:
        return [(op or "=", NpmVersion(ma, mi, pa, pre))]
    # a partial version: an x-range
    if op in ("", "="):
        lo = _lower(ma, mi or 0, 0)
        hi = _upper(ma + 1, 0, 0) if mi is None else _upper(ma, mi + 1, 0)
        return [(">=", lo), ("<", hi)]
    if op == ">":
        return [(">=", _lower(ma + 1, 0, 0) if mi is None else _lower(ma, mi + 1, 0))]
    if op == "<=":
        return [("<", _upper(ma + 1, 0, 0) if mi is None else _upper(ma, mi + 1, 0))]
    if op == ">=":
        return [(">=", _lower(ma, mi or 0, 0))]
    return [("<", _upper(ma, mi or 0, 0))]  # "<"


def npm_range(text: str) -> list[list[Comparator]]:
    """A node-semver range: sets joined by `||`, each a hyphen range or comparators separated by spaces."""
    sets: list[list[Comparator]] = []
    for alt in text.split("||"):
        alt = alt.strip()
        hy = re.match(r"^(\S+)\s+-\s+(\S+)$", alt)
        comps: list[Comparator] = []
        if hy:
            ma, mi, pa, pre = _partial(hy.group(1))
            if ma is not None:
                comps.append((">=", NpmVersion(ma, mi or 0, pa or 0, pre)))
            ma, mi, pa, pre = _partial(hy.group(2))
            if ma is not None:
                if mi is None:
                    comps.append(("<", _upper(ma + 1, 0, 0)))
                elif pa is None:
                    comps.append(("<", _upper(ma, mi + 1, 0)))
                else:
                    comps.append(("<=", NpmVersion(ma, mi, pa, pre)))
        else:
            alt = re.sub(r"(<=|>=|<|>|=|~>?|\^)\s+", r"\1", alt)  # `>= 1.2` is `>=1.2`
            for tok in alt.split():
                comps.extend(_comparators(tok))
        sets.append(comps)
    return sets


def _cmp(op: str, v: NpmVersion, bound: NpmVersion) -> bool:
    a, b = v.key(), bound.key()
    return {"<": a < b, "<=": a <= b, ">": a > b, ">=": a >= b, "=": a == b}[op]


def npm_satisfies(v: NpmVersion, sets: list[list[Comparator]]) -> bool:
    for comps in sets:
        if not all(_cmp(op, v, b) for op, b in comps):
            continue
        if not v.pre:
            return True
        # a pre-release only through a comparator that names one on the same major.minor.patch
        if any(b.pre and b.pre != (0,) and b.triple() == v.triple() for _, b in comps):
            return True
    return False


# ── what the command installs (FR-5 to FR-9) ────────────────────────────────────────────────────


@dataclass
class Req:
    name: str  # as written
    key: str  # normalized: PEP 503 for pypi, the name itself for npm
    spec: str  # the version, range or tag named ("" = none)
    source: str  # registry | local | url
    origin: str  # argv | -r FILE | MANIFEST
    alias_of: str = ""  # npm `alias@npm:real@spec`


@dataclass
class Install:
    ecosystem: str  # pypi | npm
    tool: str  # pip | uv | npm | pnpm
    argv: list[str]
    packages: list[Req] = field(default_factory=list)
    lockfile_only: bool = False
    unreadable: list[str] = field(default_factory=list)
    allow_pre: bool = False
    index_url: str | None = None
    extra_index_urls: list[str] = field(default_factory=list)
    indexes: list[str] = field(default_factory=list)  # uv --index (highest priority)
    no_index: bool = False
    registry: str | None = None  # npm/pnpm --registry
    scoped_registries: dict[str, str] = field(default_factory=dict)
    npm_config: dict[str, str] = field(default_factory=dict)  # --userconfig / --globalconfig
    project_dir: str | None = None  # --prefix / -C / --dir / --project / --directory
    isolated: bool = False  # pip --isolated
    interpreter: str | None = None  # the python that runs pip (its site pip.conf)
    hashed_pins: dict[str, set[str]] = field(default_factory=dict)  # from hashed -r files (FR-23)
    lock_paths: list[str] = field(default_factory=list)  # hashed -r files read
    global_install: bool = False
    local_bin: str | None = None  # npx/pnpm dlx: a command a project bin may already provide


PEP508_NAME = re.compile(r"^\s*([A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?)\s*(\[[^\]]*\])?\s*(.*)$")
URL_RE = re.compile(r"^(?:[a-z][a-z0-9+.-]*://|git\+|hg\+|svn\+|bzr\+)", re.IGNORECASE)
ARCHIVE_RE = re.compile(r"\.(?:whl|tar\.gz|tgz|tar\.bz2|tar\.xz|zip|tar)$", re.IGNORECASE)


def pep503(name: str) -> str:
    return re.sub(r"[-_.]+", "-", name).lower()


def py_req(text: str, origin: str, cwd: Path) -> Req:
    """One pip requirement: a PEP 508 name with extras, specifier and marker; a URL; or a local path."""
    t = text.strip()
    if URL_RE.match(t):
        return Req(t, t, "", "url", origin)
    direct = re.match(r"^([A-Za-z0-9][A-Za-z0-9._-]*)\s*(?:\[[^\]]*\])?\s*@", t)
    if direct:  # PEP 508 direct reference, `name @ https://…`, before any path test: it may end in .whl
        return Req(direct.group(1), pep503(direct.group(1)), "", "url", origin)
    if (
        t.startswith((".", "/", "~/"))
        or ("/" in t and not URL_RE.match(t) and "@" not in t)
        or ARCHIVE_RE.search(t)
        or (cwd / t / "pyproject.toml").is_file()
        or (cwd / t / "setup.py").is_file()
    ):
        return Req(t, t, "", "local", origin)
    m = PEP508_NAME.match(t)
    if not m:
        raise SpecError(f"cannot read the requirement {t!r}")
    name, rest = m.group(1), m.group(3).strip()
    if rest.startswith("@"):  # PEP 508 direct reference: `name @ https://…`
        return Req(name, pep508_key(name), "", "url", origin)
    spec = rest.split(";", 1)[0].strip()
    py_specifier(spec)  # raises SpecError when it does not parse
    return Req(name, pep503(name), spec, "registry", origin)


def pep508_key(name: str) -> str:
    return pep503(name)


NPM_NAME = re.compile(r"^(?:@[a-z0-9][a-z0-9._~-]*/)?[a-z0-9._~-][a-z0-9._~-]*$", re.IGNORECASE)


def npm_req(text: str, origin: str, cwd: Path, spec_of: str | None = None) -> Req:
    """One npm spec: `name`, `name@spec`, `@scope/name@spec`, `alias@npm:real@spec`, a path, a URL, a git ref.

    With `spec_of` set, `text` is a manifest's value for the dependency `spec_of` (package.json).
    """
    if spec_of is not None:
        name, spec = spec_of, text.strip()
    else:
        t = text.strip()
        if URL_RE.match(t) or t.startswith(("github:", "gitlab:", "bitbucket:", "gist:")):
            return Req(t, t, "", "url", origin)
        if t.startswith((".", "/", "~/", "file:")) or ARCHIVE_RE.search(t):
            return Req(t, t, "", "local", origin)
        if "/" in t and not t.startswith("@"):  # user/repo: GitHub shorthand
            return Req(t, t, "", "url", origin)
        at = t.find("@", 1)
        name, spec = (t, "") if at < 0 else (t[:at], t[at + 1 :])
    if not NPM_NAME.match(name):
        raise SpecError(f"cannot read the package name {name!r}")
    if spec.startswith("npm:"):  # an alias: the real package is after npm:
        real = npm_req(spec[4:], origin, cwd)
        real.alias_of = name
        return real
    if URL_RE.match(spec) or spec.startswith(("github:", "gitlab:", "bitbucket:", "gist:")):
        return Req(name, name, spec, "url", origin)
    if spec.startswith(("file:", "link:", "workspace:", "portal:", ".", "/", "~/")):  # ~1.2 is a range
        return Req(name, name, spec, "local", origin)
    if "/" in spec and not spec.startswith("@"):
        return Req(name, name, spec, "url", origin)
    if spec and npm_version(spec) is None and not _is_tag(spec):
        npm_range(spec)  # raises SpecError when it does not parse
    return Req(name, name, spec, "registry", origin)


def _is_tag(spec: str) -> bool:
    """A dist-tag (`latest`, `next`): not a version and not a range."""
    return bool(re.match(r"^[A-Za-z][A-Za-z0-9._-]*$", spec)) and spec.lower() not in ("x",)


class Options:
    """An installer's option table: which flags take a value, which are switches (FR-9)."""

    def __init__(self, values: Iterable[str], switches: Iterable[str]) -> None:
        self.values = set(values)
        self.switches = set(switches)

    def split(self, args: Sequence[str]) -> Iterator[tuple[str, str]]:
        """Yield (option, value) for options, with "" as a switch's value, and ("", word) for positionals.

        Raises SpecError when a word could be an option's value or a package (FR-9).
        """
        i = 0
        positional_only = False
        while i < len(args):
            a = args[i]
            if positional_only or a == "-" or not a.startswith("-"):
                yield "", a
            elif a == "--":
                positional_only = True
            elif a.startswith("--") and "=" in a:
                k, v = a.split("=", 1)
                yield k, v
            elif a in self.values:
                if i + 1 >= len(args):
                    raise SpecError(f"{a} needs a value")
                yield a, args[i + 1]
                i += 1
            elif a in self.switches or a.startswith("--no-"):
                yield a, ""
            elif not a.startswith("--") and len(a) > 2 and a[:2] in self.values:
                yield a[:2], a[2:]  # -rfile, -ihttps://…
            elif not a.startswith("--") and len(a) > 2 and all(f"-{c}" in self.switches for c in a[1:]):
                for c in a[1:]:
                    yield f"-{c}", ""
            elif i + 1 < len(args) and not args[i + 1].startswith("-"):
                raise SpecError(
                    f"{a} is not an option the guard knows, so {args[i + 1]!r} could be its value"
                    " or a package"
                )
            else:
                yield a, ""
            i += 1


