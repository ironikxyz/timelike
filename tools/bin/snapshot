#!/opt/timelike/python/bin/python3 -I
"""snapshot — take and list snapshots of the workspace, so a wrong turn can be undone (P5).

`snapshot` copies every file, symlink and directory of the workspace (tracked, untracked or ignored by
version control) into a content-addressed store in the per-workspace state root (rule 10 at revision 11;
slice 1, FR-25), shared by every session and agent, and prints the snapshot's identifier, file count and
size. `snapshot list` lists them. `undo` (a separate command that
loads this file) restores one.

Scope and limits, stated rather than implied (T2):
- the workspace is the nearest directory upward holding `.git`, else the current directory; the
  filesystem root, the home directory and their ancestors are refused (G1);
- every `.git` is out of scope at any depth: never captured, restored, removed or followed (revision 8);
- beyond the caps a snapshot is partial and names each excluded file and why, or (entry cap) refused;
  the size cap counts the bytes a snapshot adds to the store, after deduplication (revision 11);
- "taken" is said only after the record and every object it names are read back and re-hashed.

No git is run and nothing is hard-linked. Design: .specswarm/features/005-recover/ (spec, research
R1–R9, data-model.md, contracts/recover-cli.md).
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import hashlib
import json
import os
import pwd
import re
import shlex
import stat
import time
from collections.abc import Iterator
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

import agentio

ENV_MAX_BYTES = "TIMELIKE_SNAPSHOT_MAX_BYTES"
ENV_MAX_FILE_BYTES = "TIMELIKE_SNAPSHOT_MAX_FILE_BYTES"
ENV_MAX_ENTRIES = "TIMELIKE_SNAPSHOT_MAX_ENTRIES"
DEFAULT_CAPS = {
    ENV_MAX_BYTES: 256 * 1024 * 1024,
    ENV_MAX_FILE_BYTES: 64 * 1024 * 1024,
    ENV_MAX_ENTRIES: 50_000,
}
ENV_MAX_AGE_DAYS = "TIMELIKE_SNAPSHOT_MAX_AGE_DAYS"
ENV_STATE_MAX_BYTES = "TIMELIKE_STATE_MAX_BYTES"
ENV_PURGE_SECONDS = "TIMELIKE_PURGE_SECONDS"
PURGE_DEFAULTS = {ENV_MAX_AGE_DAYS: 30, ENV_STATE_MAX_BYTES: 4 * 1024**3, ENV_PURGE_SECONDS: 2}
LOCK_WAIT_S = 10.0
AGENT_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")  # TIMELIKE_AGENT, as the journal validates it (009)
NOTES: list[str] = []  # lines every result of this invocation carries (FR-27, FR-30, FR-37), in order
RECORD_VERSION = 1
SAFETY_PREFIX = "before undo "  # the reason on the snapshot an undo takes of the state it replaces
OUT_OF_SCOPE = ".git"  # version control's own state: the project's, never ours (D-4)
CHUNK = 1 << 20

TOOL = agentio.Tool(
    name="snapshot",
    target="workspace",
    summary="take a snapshot of the workspace (every file, git-ignored ones too) so undo can restore it",
    usage=[
        "snapshot [-m TEXT]       # take one: prints its id, file count and size, and what was left out",
        "snapshot list            # this workspace's snapshots, newest first",
        "undo [ID] --yes          # restore one (the newest by default); undo --dry-run shows the changes",
        "workspace: the nearest directory upward holding .git, else here; never ~ or /",
        f"caps: {ENV_MAX_BYTES}, {ENV_MAX_FILE_BYTES}, {ENV_MAX_ENTRIES} (0 = none)",
    ],
    probe=("list",),
    exit_codes={
        agentio.EXIT_OK: "ok",
        agentio.EXIT_FAILURE: "refused (home, root, over the entry cap) or failed",
        agentio.EXIT_USAGE: "usage, or a cap variable that is not a number",
    },
    manifest_extra=lambda: {"caps": {k: DEFAULT_CAPS[k] for k in sorted(DEFAULT_CAPS)}},
    event_ref=("snapshot", "id"),  # the session journal's pointer (feature 009)
)

UNDO_TOOL = agentio.Tool(
    name="undo",
    target="workspace",
    summary="restore the workspace to a snapshot (the newest by default); dry run first, verified after",
    usage=[
        "undo --dry-run           # list exactly what a restore would change; change nothing",
        "undo --yes               # restore the newest snapshot, verify it, keep the replaced state",
        "undo ID --yes            # restore snapshot ID (see: snapshot list)",
        "without --yes: exit 4 and the confirmation envelope (its confirm is undo … --yes)",
        "never touches any .git; files left out of the snapshot are left alone",
        "undo --trash [ID --yes]  # list deleted files kept in the trash, or put item ID back",
    ],
    mutating=True,
    confirm_protocol=True,  # discovery revision 13, case 1: "everything since" is not named exactly
    event_ref=("snapshot", "id"),
    destructive=True,
    probe=("--dry-run",),
    exit_codes={
        agentio.EXIT_OK: "ok (restored and verified, or nothing to change)",
        agentio.EXIT_FAILURE: "refused, or the restore could not be verified",
        agentio.EXIT_USAGE: "usage",
        agentio.EXIT_NOT_FOUND: "no such snapshot",
        agentio.EXIT_CONFIRM: "confirmation required: rerun with --yes",
    },
)


# ── small helpers ─────────────────────────────────────────────────────────────────────────────


def human(n: int) -> str:
    if n < 1024:
        return f"{n} B"
    size = float(n)
    for unit in ("KiB", "MiB", "GiB", "TiB"):
        size /= 1024
        if size < 1024 or unit == "TiB":
            return f"{size:.1f} {unit}"
    raise AssertionError("unreachable")


def caps_from_env() -> dict[str, int]:
    caps = {}
    for var, default in DEFAULT_CAPS.items():
        raw = os.environ.get(var, "").strip()
        if raw == "":
            caps[var] = default
        elif raw.isdigit():
            caps[var] = int(raw)
        else:
            unit = "entries" if var == ENV_MAX_ENTRIES else "bytes"
            raise agentio.UsageError(
                f"{var} must be a non-negative whole number of {unit}, not {raw!r}",
                f"e.g. {var}={default}, or 0 for no cap",
            )
    return caps


def purge_limits() -> dict[str, int]:
    """FR-36's three limits from the environment; 0 = none. A bad value is a usage error naming it."""
    out = {}
    for var, default in PURGE_DEFAULTS.items():
        raw = os.environ.get(var, "").strip()
        if raw == "":
            out[var] = default
        elif raw.isdigit():
            out[var] = int(raw)
        else:
            raise agentio.UsageError(
                f"{var} must be a non-negative whole number, not {raw!r}", f"e.g. {var}={default}, or 0 for none"
            )
    return out


class Outcome(Exception):
    """A refusal, a missing snapshot or a failed verification: a verdict on stdout, not a stderr error.

    The conformance probes (`snapshot list`, `undo --dry-run`) run wherever conform runs, which in the
    image is the home directory, so these outcomes must be results with a header (rule 12), as
    `adele status` reports an unreachable Adele. Usage, lock and I/O failures stay errors (rule 14).
    """

    def __init__(self, code: int, verdict: str, remedy: str, lines: list[str] | None = None) -> None:
        super().__init__(verdict)
        self.code, self.verdict, self.remedy, self.lines = code, verdict, remedy, list(lines or [])

    def result(self, target: str, scope: str) -> agentio.Result:
        return agentio.Result(
            target,
            scope,
            self.verdict,
            lines=[f"do instead: {self.remedy}", *self.lines],
            data={"remedy": self.remedy},
            exit=self.code,
        )


def refuse(what: str, remedy: str) -> Outcome:
    return Outcome(agentio.EXIT_FAILURE, f"refused: {what}", remedy)


def has_git_part(rel: str) -> bool:
    return OUT_OF_SCOPE in rel.split("/")


def check_rel(rel: str) -> None:
    """A record path is relative, normalised, and never inside `.git` (defence in depth for D-4)."""
    parts = rel.split("/")
    if not rel or rel.startswith("/") or any(p in ("", ".", "..") for p in parts) or OUT_OF_SCOPE in parts:
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"refused to touch {rel!r}: not a path inside the workspace's own files",
            "the snapshot record is damaged; take a new snapshot",
        )


# ── the workspace (FR-1 to FR-3, D-2) ─────────────────────────────────────────────────────────


def home_dirs() -> list[str]:
    homes = []
    env_home = os.environ.get("HOME", "")
    if env_home:
        homes.append(os.path.realpath(env_home))
    with contextlib.suppress(KeyError):
        homes.append(os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir))
    return list(dict.fromkeys(homes))  # $HOME first: it is the one the remedy names


def find_workspace() -> str:
    """FR-1: the nearest ancestor holding a `.git` entry, else the current directory (agentio, 007 s1)."""
    return agentio.workspace()


def store_root() -> str:
    """Where every workspace's store lives: <state root>/workspaces (FR-25; data-model § State root)."""
    return os.path.realpath(os.path.join(str(agentio.state_root()), "workspaces"))


def agent_id() -> str | None:
    raw = os.environ.get("TIMELIKE_AGENT", "")
    return raw if AGENT_RE.match(raw) else None


def note_persistence() -> dict[str, Any]:
    """FR-27: the not-persistent line when the state root is on the container's own filesystem."""
    root = agentio.state_root()
    persistent = agentio.state_persistent(root)
    if not persistent:
        add_note(agentio.not_persistent_line(root))
    return {"root": str(root), "persistent": persistent}


def add_note(line: str) -> None:
    if line not in NOTES:
        NOTES.append(line)


def finish(r: agentio.Result, state: dict[str, Any]) -> agentio.Result:
    """Every result carries NOTES after its `do instead:` line (contract § Slice 1) and data.state.

    A result that was cut already holds them: cut_or_lines puts NOTES first before it cuts.
    """
    if r.cut is None:
        at = 1 if r.lines and r.lines[0].startswith("do instead: ") else 0
        r.lines[at:at] = [n for n in NOTES if n not in r.lines]
    r.data["state"] = state
    return r


def check_workspace(ws: str, ctx: agentio.Context, command: str) -> None:
    homes = home_dirs()
    home = homes[0] if homes else "your home directory"
    remedy = f"change into the project directory (a directory below {home}) and run {command} again"
    if ws == "/":
        raise refuse(f"{ws} is the filesystem root", remedy)
    for h in homes:
        if ws == h:
            raise refuse(f"{ws} is your home directory", remedy)
        if h.startswith(ws.rstrip("/") + "/"):
            raise refuse(f"{ws} is an ancestor of your home directory", remedy)
    store = os.path.realpath(str(agentio.state_root()))
    if store == ws or store.startswith(ws.rstrip("/") + "/"):
        raise refuse(
            f"{ws} contains the snapshot store ({store})",
            f"set {agentio.STATE_ROOT_ENV} outside the workspace",
        )


# ── the walk (data-model § What the walk sees) ────────────────────────────────────────────────

Entry = dict[str, Any]  # {kind: file|link|dir|other, mode, size, target, what, error}


class EntryCapExceeded(Exception):
    pass


class LockBusy(agentio.ToolError):
    """The store's lock stayed held past the wait (FR-24): an error naming the holder (FR-38)."""


def _other_kind(mode: int) -> str:
    if stat.S_ISSOCK(mode):
        return "socket"
    if stat.S_ISFIFO(mode):
        return "fifo"
    if stat.S_ISBLK(mode):
        return "block device"
    if stat.S_ISCHR(mode):
        return "character device"
    return "unknown file type"


def walk(ws: str, max_entries: int) -> tuple[dict[str, Entry], list[str]]:
    """Every entry under `ws` except `.git`, by relative path; and the directories holding a `.git`."""
    entries: dict[str, Entry] = {}
    git_holders: list[str] = []
    stack = [""]
    seen = 0
    while stack:
        rel_dir = stack.pop()
        abs_dir = os.path.join(ws, rel_dir) if rel_dir else ws
        try:
            with os.scandir(abs_dir) as it:
                children = sorted(it, key=lambda e: e.name)
        except OSError as e:
            if rel_dir:
                entries[rel_dir]["error"] = e.strerror or str(e)
            continue
        for child in children:
            rel = f"{rel_dir}/{child.name}" if rel_dir else child.name
            if child.name == OUT_OF_SCOPE:
                git_holders.append(rel_dir)
                continue
            seen += 1
            if max_entries and seen > max_entries:
                raise EntryCapExceeded()
            try:
                st = child.stat(follow_symlinks=False)
            except OSError as e:
                entries[rel] = {
                    "kind": "other",
                    "what": "unreadable",
                    "size": 0,
                    "error": e.strerror or str(e),
                }
                continue
            perm = stat.S_IMODE(st.st_mode)
            if stat.S_ISLNK(st.st_mode):
                entries[rel] = {"kind": "link", "target": os.readlink(child.path)}
            elif stat.S_ISDIR(st.st_mode):
                entries[rel] = {"kind": "dir", "mode": perm}
                stack.append(rel)
            elif stat.S_ISREG(st.st_mode):
                entries[rel] = {
                    "kind": "file",
                    "mode": perm,
                    "size": st.st_size,
                    "stat": [st.st_size, st.st_mtime_ns, st.st_ctime_ns, st.st_ino],  # FR-35's key
                }
            else:
                entries[rel] = {"kind": "other", "what": _other_kind(st.st_mode), "size": 0}
    return entries, git_holders


def file_sha(path: str) -> str:
    h = hashlib.sha256()
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    with os.fdopen(fd, "rb") as f:
        for block in iter(lambda: f.read(CHUNK), b""):
            h.update(block)
    return h.hexdigest()


# ── the store (data-model § Store) ────────────────────────────────────────────────────────────


class Store:
    def __init__(self, ctx: agentio.Context, ws: str) -> None:
        self.ws = ws
        self.key = hashlib.sha256(ws.encode()).hexdigest()[:16]
        self.ctx = ctx
        self.path = Path(store_root()) / self.key

    def exists(self) -> bool:
        return (self.path / "workspace").is_file()

    def create(self) -> None:
        agentio.ensure_state_root()  # private, versioned (FR-25, FR-28; P003)
        try:
            for sub in ("snaps", "objects", "artefacts"):
                (self.path / sub).mkdir(mode=0o700, parents=True, exist_ok=True)
            os.chmod(self.path.parent, 0o700)
            os.chmod(self.path, 0o700)
        except OSError as e:
            raise agentio.ToolError(
                agentio.EXIT_FAILURE,
                f"cannot create the snapshot store {self.path}: {e.strerror or e}",
                f"check {agentio.STATE_ROOT_ENV} is writable",
            ) from None
        marker = self.path / "workspace"
        if marker.exists():
            self.check_owner()
        else:
            self._write_atomic(marker, self.ws + "\n", 0o600)

    def check_owner(self) -> None:
        recorded = (self.path / "workspace").read_text().strip()
        if recorded != self.ws:
            raise agentio.ToolError(
                agentio.EXIT_FAILURE,
                f"the snapshot store {self.path} belongs to {recorded}, not {self.ws}",
                "remove that store directory, or snapshot from another directory",
            )

    @contextlib.contextmanager
    def lock(self, wait_s: float = LOCK_WAIT_S) -> Iterator[None]:
        """FR-24, FR-38: one lock per workspace store, shared by every session and agent.

        flock(2): the kernel releases it when its holder exits, so a holder that no longer exists holds
        nothing and there is no stale lock to clear. The holder writes who it is, for the timeout verdict.
        """
        fd = os.open(self.path / "lock", os.O_RDWR | os.O_CREAT, 0o600)
        try:
            deadline = time.monotonic() + wait_s
            while True:
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        raise self._busy(fd, wait_s) from None
                    time.sleep(0.05)
            holder = f"{os.getpid()} {self.ctx.session} {agent_id() or '-'}\n".encode()
            with contextlib.suppress(OSError):
                os.ftruncate(fd, 0)
                os.pwrite(fd, holder, 0)
            try:
                yield
            finally:
                with contextlib.suppress(OSError):
                    os.ftruncate(fd, 0)  # released: no holder to name (a later wait names none)
        finally:
            os.close(fd)

    def _busy(self, fd: int, wait_s: float) -> LockBusy:
        who = ""
        with contextlib.suppress(OSError, ValueError):
            pid, session, agent = os.pread(fd, 256, 0).decode().split()[:3]
            who = f"; holder pid {pid}, session {session}, agent {agent}"
        return LockBusy(
            agentio.EXIT_FAILURE,
            "another snapshot or undo is running on this workspace"
            f" (lock held for {wait_s:.0f} s: {self.path / 'lock'}{who})",
            "wait for it to finish, then run this again",
        )

    def _write_atomic(self, path: Path, text: str, mode: int) -> None:
        tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, path)

    def next_id(self) -> int:
        p = self.path / "next"
        n = int(p.read_text().strip()) if p.exists() else 1
        self._write_atomic(p, f"{n + 1}\n", 0o600)
        return n

    def object_path(self, sha: str) -> Path:
        return self.path / "objects" / sha[:2] / sha

    def put(self, src: str) -> tuple[str, int, bool]:
        """Copy `src` (never followed) into the store; its sha256, the bytes read, and whether it was new."""
        tmp = self.path / "objects" / f".in.{os.getpid()}.tmp"
        h = hashlib.sha256()
        size = 0
        fd = os.open(src, os.O_RDONLY | os.O_NOFOLLOW)
        try:
            with os.fdopen(fd, "rb") as fin, open(tmp, "wb") as fout:
                for block in iter(lambda: fin.read(CHUNK), b""):
                    h.update(block)
                    fout.write(block)
                    size += len(block)
            sha = h.hexdigest()
            dest = self.object_path(sha)
            if os.path.lexists(dest):
                tmp.unlink()
                return sha, size, False
            dest.parent.mkdir(mode=0o700, exist_ok=True)
            os.chmod(tmp, 0o400)
            os.replace(tmp, dest)
            return sha, size, True
        finally:
            with contextlib.suppress(FileNotFoundError):
                tmp.unlink()

    def has(self, sha: str) -> bool:
        return os.path.lexists(self.object_path(sha))

    def statcache(self) -> dict[str, list[Any]]:
        """FR-35: path → [size, mtime_ns, ctime_ns, inode, sha256] from the last take; {} if unreadable."""
        try:
            doc = json.loads((self.path / "statcache.json").read_text())
        except (OSError, ValueError):
            return {}
        return doc if isinstance(doc, dict) else {}

    def write_statcache(self, cache: dict[str, list[Any]]) -> None:
        with contextlib.suppress(OSError):
            self._write_atomic(self.path / "statcache.json", json.dumps(cache, sort_keys=True) + "\n", 0o600)

    def record_path(self, ident: int) -> Path:
        return self.path / "snaps" / f"{ident}.json"

    def write_record(self, rec: dict[str, Any]) -> None:
        self._write_atomic(self.record_path(rec["id"]), json.dumps(rec, indent=1) + "\n", 0o600)

    def verify(self, rec: dict[str, Any]) -> str | None:
        """Can `rec` be restored? Read its record back, and re-hash every object it names (stack note 12).

        Returns what is wrong, or None. A damaged object is removed, so the next snapshot stores it again
        instead of trusting the copy `put` found in place.
        """
        try:
            back = json.loads(self.record_path(rec["id"]).read_text())
        except (OSError, ValueError) as err:
            return f"its record cannot be read back ({err})"
        if back != rec:
            return "its record reads back different from what was written"
        sizes: dict[str, int] = {}
        for e in rec["entries"]:
            try:
                check_rel(e["path"])
            except agentio.ToolError:
                return f"{e['path']!r} is not a path a restore may write"
            if e["kind"] == "file":
                sizes[e["sha256"]] = e["size"]
        for sha, size in sorted(sizes.items()):
            obj = self.object_path(sha)
            try:
                st = os.lstat(obj)
                ok = stat.S_ISREG(st.st_mode) and st.st_size == size and file_sha(str(obj)) == sha
            except OSError as err:
                return f"object {sha[:12]} cannot be read ({err.strerror or err})"
            if not ok:
                with contextlib.suppress(OSError):
                    obj.unlink()
                return f"object {sha[:12]} does not match its hash (removed; it is stored again next time)"
        return None

    def records(self) -> list[dict[str, Any]]:
        if not self.exists():
            return []
        out = []
        for p in (self.path / "snaps").glob("*.json"):
            with contextlib.suppress(ValueError, OSError):
                out.append(json.loads(p.read_text()))
        return sorted(out, key=lambda r: int(r["id"]))

    def record(self, ident: int) -> dict[str, Any] | None:
        p = self.path / "snaps" / f"{ident}.json"
        return json.loads(p.read_text()) if self.exists() and p.is_file() else None

    def artefact(self, name: str, lines: list[str]) -> str:
        text = "\n".join(lines) + "\n"
        path = self.path / "artefacts" / f"{name}-{hashlib.sha256(text.encode()).hexdigest()[:12]}.txt"
        path.write_text(text)
        return str(path)


# ── purge (FR-36, FR-37, D-16) ────────────────────────────────────────────────────────────────


def _object_bytes(store_dir: Path) -> int:
    total = 0
    with contextlib.suppress(OSError):
        for sub in os.scandir(store_dir / "objects"):
            if sub.is_dir(follow_symlinks=False):
                with os.scandir(sub.path) as it:
                    for f in it:
                        with contextlib.suppress(OSError):
                            total += f.stat(follow_symlinks=False).st_size
    return total


def _records_by_age(store_dir: Path) -> list[tuple[float, int]]:
    """(record mtime, id), oldest first. A record is written once, so its mtime is when it was taken
    (an imported record's is set to its own taken_at), and no record has to be parsed to age it."""
    out = []
    with contextlib.suppress(OSError):
        for p in (store_dir / "snaps").glob("*.json"):
            with contextlib.suppress(OSError, ValueError):
                out.append((p.stat().st_mtime, int(p.stem)))
    return sorted(out)


def _sweep(store_dir: Path) -> None:
    """Delete every object no remaining record names (mark and sweep, within one locked store)."""
    keep: set[str] = set()
    for p in (store_dir / "snaps").glob("*.json"):
        try:
            rec = json.loads(p.read_text())
        except (OSError, ValueError):
            return  # a record that cannot be read may name anything: delete nothing
        keep.update(e["sha256"] for e in rec.get("entries", []) if e.get("kind") == "file")
    with contextlib.suppress(OSError):
        for sub in os.scandir(store_dir / "objects"):
            if sub.is_dir(follow_symlinks=False):
                for f in os.scandir(sub.path):
                    if f.name not in keep and not f.name.startswith("."):
                        with contextlib.suppress(OSError):
                            os.unlink(f.path)


@contextlib.contextmanager
def _other_locks(mine: Store) -> Iterator[tuple[dict[Path, str], list[str]]]:
    """Every other store whose lock is free at this moment, locked; and the busy ones, by workspace."""
    held: dict[Path, str] = {}
    busy: list[str] = []
    fds = []
    try:
        with contextlib.suppress(OSError):
            for d in sorted(Path(store_root()).iterdir()):
                if d == mine.path:
                    continue
                try:
                    ws = (d / "workspace").read_text().strip()
                    fd = os.open(d / "lock", os.O_RDWR | os.O_CREAT, 0o600)
                except OSError:
                    continue
                try:
                    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    os.close(fd)
                    busy.append(ws)
                    continue
                fds.append(fd)
                held[d] = ws
        yield held, busy
    finally:
        for fd in fds:
            os.close(fd)


def purge(store: Store) -> list[dict[str, Any]]:
    """Purge the state root after a write; the caller holds `store`'s lock (FR-36, FR-37).

    First every snapshot older than the age limit, then the oldest snapshot of any workspace while the
    snapshot content exceeds the size cap. Never the newest snapshot of a workspace. Other workspaces'
    stores are purged only when their lock is free now (no wait). Bounded by TIMELIKE_PURGE_SECONDS.
    Each drop, and each reason it stopped short, is a NOTES line.
    """
    limits = purge_limits()
    age_s = limits[ENV_MAX_AGE_DAYS] * 86400
    cap, bound = limits[ENV_STATE_MAX_BYTES], limits[ENV_PURGE_SECONDS]
    if not age_s and not cap:
        return []
    deadline = time.monotonic() + bound if bound else None
    dropped: list[dict[str, Any]] = []
    with _other_locks(store) as (others, busy):
        stores = {store.path: store.ws, **others}
        ages = {d: _records_by_age(d) for d in stores}
        sizes = {d: _object_bytes(d) for d in stores} if cap else {}
        now = time.time()

        def drop(d: Path, ident: int, why: str) -> None:
            with contextlib.suppress(OSError):
                (d / "snaps" / f"{ident}.json").unlink()
            ages[d] = [a for a in ages[d] if a[1] != ident]
            dropped.append({"workspace": stores[d], "id": ident, "why": why})
            add_note(f"purged: snapshot {ident} of {stores[d]} ({why})")

        def over_time() -> bool:
            return deadline is not None and time.monotonic() > deadline

        stopped = None
        if age_s:
            for d in stores:
                newest = max((i for _, i in ages[d]), default=None)
                for mtime, ident in list(ages[d]):
                    if ident != newest and now - mtime > age_s:
                        drop(d, ident, f"older than {limits[ENV_MAX_AGE_DAYS]} days")
        touched = {x_d for x_d in stores if any(x["workspace"] == stores[x_d] for x in dropped)}
        for d in touched:
            _sweep(d)
            if cap:
                sizes[d] = _object_bytes(d)
        while cap and sum(sizes.values()) > cap:
            if over_time():
                stopped = f"the time bound ({ENV_PURGE_SECONDS}={bound}) was reached"
                break
            pick = None
            for d in stores:
                newest = max((i for _, i in ages[d]), default=None)
                for mtime, ident in ages[d]:
                    if ident != newest and (pick is None or mtime < pick[0]):
                        pick = (mtime, d, ident)
                    break  # oldest first: only each store's oldest can be the oldest overall
            if pick is None:
                stopped = "only each workspace's newest snapshot is left"
                break
            _, d, ident = pick
            drop(d, ident, f"over {ENV_STATE_MAX_BYTES}")
            _sweep(d)
            sizes[d] = _object_bytes(d)
        if stopped and cap and sum(sizes.values()) > cap:
            add_note(
                f"purge stopped: {stopped}; the snapshots are {human(sum(sizes.values()) - cap)}"
                f" over {ENV_STATE_MAX_BYTES}"
            )
        for ws in busy:
            add_note(f"purge skipped {ws}: another snapshot or undo holds it")
    return dropped


# ── slice 0's stores in the session scratch (FR-30, D-14) ─────────────────────────────────────


def slice0_stores(store: Store) -> list[Path]:
    """Every slice-0 store of this workspace under the scratch root, any session, not yet imported."""
    found = []
    with contextlib.suppress(OSError):
        for sdir in sorted(agentio.scratch_root().iterdir()):
            old = sdir / "snapshots" / store.key
            with contextlib.suppress(OSError):
                if (old / "imported").exists() or (old / "workspace").read_text().strip() != store.ws:
                    continue
                found.append(old)
    return found


def _ids(nums: list[int]) -> str:
    return f"{nums[0]}" if nums[0] == nums[-1] else f"{nums[0]}–{nums[-1]}"


def import_slice0(store: Store) -> list[dict[str, Any]]:
    """Import every slice-0 store of this workspace into its state-root store, once (FR-30).

    Each record keeps its order, reason, label and time, gets the next identifier, and records where it
    came from; its objects are copied (deduplicated) and it is verified as a take is. The old store is
    left in place, marked `imported` with the new identifiers, so it is never imported twice. Nothing a
    user took vanishes silently: each import, and each record that fails verification, is a NOTES line.
    """
    olds = slice0_stores(store)
    if not olds:
        return []
    store.create()
    done = []
    with store.lock():
        for old in slice0_stores(store):  # again, under the lock: another process may have done it
            session = old.parent.parent.name
            recs = []
            for p in (old / "snaps").glob("*.json"):
                with contextlib.suppress(OSError, ValueError):
                    recs.append(json.loads(p.read_text()))
            pairs: list[tuple[int, int]] = []
            for rec in sorted(recs, key=lambda r: int(r["id"])):
                problem = _import_one(store, old, session, rec, pairs)
                if problem:
                    add_note(f"not imported: {session} snapshot {rec['id']}: {problem}")
            text = "".join(f"{a} {b}\n" for a, b in pairs)
            with contextlib.suppress(OSError):
                store._write_atomic(old / "imported", text, 0o600)
            if pairs:
                was, now = [a for a, _ in pairs], [b for _, b in pairs]
                add_note(
                    f"imported {len(pairs)} snapshots from session {session} (were {_ids(was)}, now {_ids(now)})"
                )
                done.append({"session": session, "was": was, "now": now})
    return done


def _import_one(
    store: Store, old: Path, session: str, rec: dict[str, Any], pairs: list[tuple[int, int]]
) -> str | None:
    for e in rec.get("entries", []):
        if e.get("kind") == "file" and not store.has(e["sha256"]):
            src = old / "objects" / e["sha256"][:2] / e["sha256"]
            try:
                sha, _, _ = store.put(str(src))
            except OSError as err:
                return f"object {e['sha256'][:12]} cannot be read ({err.strerror or err})"
            if sha != e["sha256"]:
                return f"object {e['sha256'][:12]} does not match its hash"
    new = dict(rec)
    new.update(id=store.next_id(), imported={"session": session, "id": rec["id"]})
    new.setdefault("session", session)
    new.setdefault("agent", None)
    store.write_record(new)
    with contextlib.suppress(OSError, ValueError, KeyError):  # its age is its own, for the purge (FR-36)
        t = datetime.fromisoformat(rec["taken_at"]).timestamp()
        os.utime(store.record_path(new["id"]), (t, t))
    problem = store.verify(new)
    if problem is not None:
        with contextlib.suppress(OSError):
            store.record_path(new["id"]).unlink()
        return problem
    pairs.append((int(rec["id"]), new["id"]))
    return None


# ── taking a snapshot (FR-4 to FR-11) ─────────────────────────────────────────────────────────


def _exclusion(rel: str, size: int, reason: str) -> dict[str, Any]:
    return {"path": rel, "size": size, "reason": reason}


def take_locked(store: Store, caps: dict[str, int], reason: str, label: str | None) -> dict[str, Any]:
    """Walk, choose, copy, record, verify. The caller holds the store's lock and has created the store.

    Raises Outcome when the snapshot cannot be shown restorable: then it is not taken (no record stays).
    """
    try:
        entries, _ = walk(store.ws, caps[ENV_MAX_ENTRIES])
    except EntryCapExceeded:
        raise refuse(
            f"{store.ws} has more than {caps[ENV_MAX_ENTRIES]} entries ({ENV_MAX_ENTRIES})",
            f"snapshot a smaller directory, or raise {ENV_MAX_ENTRIES}",
        ) from None
    excluded: list[dict[str, Any]] = []
    candidates: list[tuple[str, int]] = []
    for rel, e in entries.items():
        if e["kind"] == "other":
            if e.get("what") == "unreadable":
                excluded.append(_exclusion(rel, 0, f"unreadable: {e.get('error', 'unknown error')}"))
            else:
                excluded.append(_exclusion(rel, 0, f"not a regular file, symlink or directory ({e['what']})"))
        elif e["kind"] == "dir" and "error" in e:
            excluded.append(_exclusion(rel, 0, f"unreadable: {e['error']}"))
        elif e["kind"] == "file":
            if caps[ENV_MAX_FILE_BYTES] and e["size"] > caps[ENV_MAX_FILE_BYTES]:
                excluded.append(
                    _exclusion(rel, e["size"], f"over the per-file limit ({caps[ENV_MAX_FILE_BYTES]} bytes)")
                )
            else:
                candidates.append((rel, e["size"]))
    # FR-35: a file whose size, mtime, ctime and inode match the last take, and whose object is still in
    # the store, is recorded without being read. Verification (below) still re-hashes every object.
    old_cache = store.statcache()
    known: dict[str, str] = {}
    for rel, e in entries.items():
        hit = old_cache.get(rel)
        if e["kind"] == "file" and hit and hit[:4] == e["stat"] and store.has(str(hit[4])):
            known[rel] = str(hit[4])
    candidates, cut, needed = _fit_size_cap(store, caps[ENV_MAX_BYTES], candidates, known)
    excluded.extend(cut)
    captured: list[Entry] = []
    new_cache: dict[str, list[Any]] = {}
    total = stored = 0
    for rel, size in sorted(candidates):
        if rel in known:
            sha, read, new = known[rel], size, False
        else:
            try:
                sha, read, new = store.put(os.path.join(store.ws, rel))
            except OSError as err:
                excluded.append(_exclusion(rel, size, f"unreadable: {err.strerror or err}"))
                continue
        if read == entries[rel]["size"]:
            new_cache[rel] = [*entries[rel]["stat"], sha]  # a file that changed while read is not cached
        total += read
        stored += read if new else 0
        captured.append(
            {"path": rel, "kind": "file", "sha256": sha, "size": read, "mode": entries[rel]["mode"]}
        )
    for rel, e in entries.items():
        if e["kind"] == "dir":
            captured.append({"path": rel, "kind": "dir", "mode": e["mode"]})
        elif e["kind"] == "link":
            captured.append({"path": rel, "kind": "link", "target": e["target"]})
    captured.sort(key=lambda c: c["path"])
    excluded.sort(key=lambda x: x["path"])
    rec = {
        "v": RECORD_VERSION,
        "id": store.next_id(),
        "reason": reason,
        "label": label,
        "workspace": store.ws,
        "session": store.ctx.session,
        "agent": agent_id(),
        "taken_at": datetime.now(UTC).isoformat(timespec="seconds"),
        "entries": captured,
        "excluded": excluded,
        "files": sum(1 for c in captured if c["kind"] == "file"),
        "links": sum(1 for c in captured if c["kind"] == "link"),
        "dirs": sum(1 for c in captured if c["kind"] == "dir"),
        "bytes": total,
        "stored_bytes": stored,
        "excluded_bytes": sum(x["size"] for x in excluded),
        "partial": bool(excluded),
        "caps": {
            "max_bytes": caps[ENV_MAX_BYTES],
            "max_file_bytes": caps[ENV_MAX_FILE_BYTES],
            "max_entries": caps[ENV_MAX_ENTRIES],
        },
    }
    if needed is not None:
        rec["size_cap_needed"] = needed
    store.write_record(rec)
    store.write_statcache(new_cache)
    problem = store.verify(rec)
    if problem is not None:
        with contextlib.suppress(OSError):
            store.record_path(rec["id"]).unlink()
        raise Outcome(
            agentio.EXIT_FAILURE,
            f"snapshot {rec['id']} not taken: it could not be verified restorable: {problem}",
            f"run snapshot again; if this repeats, the store {store.path} is damaged:"
            " remove it and take a new snapshot",
        )
    return rec


def _fit_size_cap(
    store: Store, cap: int, candidates: list[tuple[str, int]], known: dict[str, str] | None = None
) -> tuple[list[tuple[str, int]], list[dict[str, Any]], int | None]:
    """Apply the size cap to the bytes this snapshot would ADD to the store (revision 11, condition 3).

    Content already in the store, or repeated within this snapshot, is stored once and counts once. When
    even the files' plain sizes fit, nothing is hashed twice. Otherwise each file is hashed, and the
    largest new content is left out first (ties by path); files sharing content are left out together,
    since leaving out one alone saves nothing. Returns the files to copy, the exclusions, and (when the
    cap bit) the cap that would have captured everything.
    """
    if not cap or sum(s for _, s in candidates) <= cap:
        return candidates, [], None
    keep: list[tuple[str, int]] = []
    cut: list[dict[str, Any]] = []
    groups: dict[str, list[tuple[str, int]]] = {}
    for rel, size in candidates:
        try:
            sha = (known or {}).get(rel) or file_sha(os.path.join(store.ws, rel))
        except OSError as err:
            cut.append(_exclusion(rel, size, f"unreadable: {err.strerror or err}"))
            continue
        if store.has(sha):
            keep.append((rel, size))  # stored already: costs nothing
        else:
            groups.setdefault(sha, []).append((rel, size))
    new_bytes = {sha: members[0][1] for sha, members in groups.items()}  # same content, same size
    needed = sum(new_bytes.values())
    total = needed
    reason = f"over the size cap: largest files left out first ({cap} bytes)"
    for sha in sorted(groups, key=lambda h: (-new_bytes[h], min(r for r, _ in groups[h]))):
        if total <= cap:
            keep.extend(groups[sha])
            continue
        total -= new_bytes[sha]
        cut.extend(_exclusion(rel, size, reason) for rel, size in groups[sha])
    return keep, cut, needed


def raise_lines(rec: dict[str, Any], caps: dict[str, int]) -> list[str]:
    """How to raise the cap(s) that bit, to the value that would have captured everything (contract)."""
    out = []
    over_file = [x["size"] for x in rec["excluded"] if x["reason"].startswith("over the per-file limit")]
    if over_file:
        out.append(f"raise with {ENV_MAX_FILE_BYTES}={max(over_file)}")
    if any(x["reason"].startswith("over the size cap") for x in rec["excluded"]):
        # The cap counts bytes new to the store, so this is what the snapshot would have added: every
        # new content it hashed, plus the files the per-file limit kept out (counted whole, unhashed).
        sizeable = rec.get("size_cap_needed", rec["stored_bytes"]) + sum(over_file)
        out.append(f"raise with {ENV_MAX_BYTES}={sizeable}")
    return out


def cut_or_lines(
    ctx: agentio.Context, store: Store, name: str, lines: list[str]
) -> tuple[list[str], agentio.Cut | None]:
    """Over the output cap, cut with `more` reading the saved list: a re-run would act again.

    NOTES go first, so a cut result carries them too (finish() only adds them to an uncut one).
    """
    lines = [n for n in NOTES if n not in lines] + lines
    if ctx.limit <= 0 or len(lines) <= ctx.limit:
        return lines, None
    head_n = max(1, ctx.limit // 2)
    tail_n = max(1, ctx.limit - head_n)
    full = store.artefact(name, lines)
    first, last = head_n + 1, len(lines) - tail_n
    omitted = lines[head_n : len(lines) - tail_n]
    cut = agentio.Cut(
        [
            (f"lines 1–{head_n} of {len(lines)}", lines[:head_n]),
            (f"lines {last + 1}–{len(lines)} of {len(lines)}", lines[last:]),
        ],
        len(omitted),
        sum(len(x.encode()) + 1 for x in omitted),
        full,
        shlex.join(["sed", "-n", f"{first},{last}p", full]),
    )
    return [], cut


def cmd_take(ctx: agentio.Context, ws: str, label: str | None) -> agentio.Result:
    caps = caps_from_env()
    store = Store(ctx, ws)
    imported = import_slice0(store)
    store.create()
    with store.lock():
        rec = take_locked(store, caps, "on demand", label)
        purged = purge(store)
    size = human(rec["bytes"])
    if rec["partial"]:
        verdict = (
            f"snapshot {rec['id']} taken (partial): {rec['files']} files, {size};"
            f" excluded {len(rec['excluded'])} files, {human(rec['excluded_bytes'])} — see below"
        )
    else:
        verdict = f"snapshot {rec['id']} taken: {rec['files']} files, {size} (complete)"
    lines = [
        f"excluded: {x['path']} ({human(x['size'])}) — {x['reason']}"
        for x in sorted(rec["excluded"], key=lambda x: (-x["size"], x["path"]))
    ] + raise_lines(rec, caps)
    shown, cut = cut_or_lines(ctx, store, "snapshot", lines)
    data = {
        k: rec[k]
        for k in (
            "id",
            "reason",
            "label",
            "files",
            "links",
            "dirs",
            "bytes",
            "stored_bytes",
            "partial",
            "excluded",
            "excluded_bytes",
        )
    }
    data["verified"] = True
    data["store"] = str(store.path)
    if imported:
        data["imported"] = imported
    data["purged"] = purged
    return agentio.Result(ws, "take", verdict, lines=shown, data=data, cut=cut)


def other_workspaces(ws: str) -> list[tuple[str, int]]:
    """FR-29: every other workspace in the state root with snapshots, by path, and how many."""
    out = []
    with contextlib.suppress(OSError):
        for d in Path(store_root()).iterdir():
            try:
                path = (d / "workspace").read_text().strip()
            except OSError:
                continue
            n = sum(1 for _ in (d / "snaps").glob("*.json"))
            if path != ws and n:
                out.append((path, n))
    return sorted(out)


def other_lines(ws: str) -> tuple[list[str], list[dict[str, Any]]]:
    others = other_workspaces(ws)
    lines = [f"other workspace with snapshots: {path} ({n})" for path, n in others]
    return lines, [{"workspace": path, "snapshots": n} for path, n in others]


def cmd_list(ctx: agentio.Context, ws: str) -> agentio.Result:
    store = Store(ctx, ws)
    imported = import_slice0(store)
    recs = list(reversed(store.records()))
    lines, items = [], []
    for r in recs:
        whole = "partial" if r["partial"] else "complete"
        line = f"{r['id']}  {r['reason']}  {r['files']} files  {human(r['bytes'])}  {whole}"
        if r.get("label"):
            line += f'  "{r["label"]}"'
        item = {k: r[k] for k in ("id", "reason", "label", "files", "bytes", "partial")}
        item["session"], item["agent"] = r.get("session"), r.get("agent")  # FR-31 (slice-0 records: null)
        if ctx.verbose:
            line += f"  taken {r['taken_at']}  session {r.get('session') or '-'}  agent {r.get('agent') or '-'}"
            item["taken_at"] = r["taken_at"]
        lines.append(line)
        items.append(item)
    data: dict[str, Any] = {"snapshots": items}
    if imported:
        data["imported"] = imported
    if not recs:
        lines, data["other_workspaces"] = other_lines(ws)
    return agentio.Result(ws, "list", f"{len(recs)} snapshots", lines=lines, data=data)


def configure(p: argparse.ArgumentParser) -> None:
    # Optional to argparse, required by main() only in shape: a required positional would make argparse
    # refuse --help and --agent-info before agentio handles them (the adele pattern).
    p.add_argument("verb", nargs="?", choices=("list",), metavar="list")
    p.add_argument("-m", dest="label", metavar="TEXT", help="a short label for the snapshot")


def main(args: argparse.Namespace, ctx: agentio.Context) -> agentio.Result:
    if args.verb == "list" and args.label is not None:
        raise agentio.UsageError("-m labels a new snapshot; snapshot list takes none", "run snapshot -m TEXT")
    if args.verb != "list":
        caps_from_env()  # a bad cap value is a usage error before anything is written
        purge_limits()
    ws = find_workspace()
    scope = "list" if args.verb == "list" else "take"
    state = note_persistence()
    try:
        check_workspace(ws, ctx, "snapshot")
        r = cmd_list(ctx, ws) if args.verb == "list" else cmd_take(ctx, ws, args.label)
    except Outcome as o:
        r = o.result(ws, scope)
    return finish(r, state)


# ── the plan (data-model § Plan) ──────────────────────────────────────────────────────────────

Change = dict[str, str]  # {change: restore|remove|keep, kind, path, why?}


def _protected(rel: str, excluded: set[str]) -> bool:
    parts = rel.split("/")
    return any("/".join(parts[:i]) in excluded for i in range(1, len(parts) + 1))


def make_plan(ws: str, rec: dict[str, Any]) -> list[Change]:
    current, git_holders = walk(ws, 0)
    snap = {e["path"]: e for e in rec["entries"]}
    excluded = {x["path"] for x in rec["excluded"]}
    plan: list[Change] = []
    for rel, s in snap.items():
        c = current.get(rel)
        if c is None:
            plan.append({"change": "restore", "kind": s["kind"], "path": rel})
        elif c["kind"] != s["kind"]:
            plan.append(
                {"change": "remove", "kind": c["kind"] if c["kind"] != "other" else "file", "path": rel}
            )
            plan.append({"change": "restore", "kind": s["kind"], "path": rel})
        elif s["kind"] == "file":
            if c["mode"] != s["mode"] or c["size"] != s["size"] or _sha_or_none(ws, rel) != s["sha256"]:
                plan.append({"change": "restore", "kind": "file", "path": rel})
        elif s["kind"] == "link":
            if c["target"] != s["target"]:
                plan.append({"change": "restore", "kind": "link", "path": rel})
        elif c["mode"] != s["mode"]:
            plan.append({"change": "restore", "kind": "dir", "path": rel})
    holds: dict[str, str] = {}
    for holder in git_holders:
        _mark_holders(holds, holder, ".git")
    for rel in excluded:
        _mark_holders(holds, rel.rsplit("/", 1)[0] if "/" in rel else "", "excluded files")
    for rel, c in current.items():
        if rel in snap or _protected(rel, excluded):
            continue
        if c["kind"] == "dir" and rel in holds:
            plan.append({"change": "keep", "kind": "dir", "path": rel, "why": holds[rel]})
        else:
            plan.append(
                {"change": "remove", "kind": c["kind"] if c["kind"] != "other" else "file", "path": rel}
            )
    order = {"remove": 0, "keep": 1, "restore": 2}
    plan.sort(key=lambda ch: (ch["path"], order[ch["change"]]))
    return plan


def _sha_or_none(ws: str, rel: str) -> str | None:
    try:
        return file_sha(os.path.join(ws, rel))
    except OSError:
        return None  # unreadable now: it differs from what was captured, so it is restored


def _mark_holders(holds: dict[str, str], rel_dir: str, what: str) -> None:
    parts = rel_dir.split("/") if rel_dir else []
    for i in range(len(parts), 0, -1):
        holds.setdefault("/".join(parts[:i]), what)


def plan_line(ch: Change) -> str:
    if ch["change"] == "keep":
        return f"keep dir {ch['path']} (holds {ch['why']})"
    return f"{ch['change']} {ch['kind']} {ch['path']}"


def counts(plan: list[Change]) -> tuple[int, int]:
    return sum(ch["change"] == "restore" for ch in plan), sum(ch["change"] == "remove" for ch in plan)


# ── applying it (FR-19, FR-20; research R3) ───────────────────────────────────────────────────


def _parent_checked(ws: str, rel: str) -> str:
    """The real directory `rel` goes into: every component from the workspace down must be a directory."""
    check_rel(rel)
    path = ws
    for comp in rel.split("/")[:-1]:
        path = os.path.join(path, comp)
        st = os.lstat(path)
        if not stat.S_ISDIR(st.st_mode):
            raise agentio.ToolError(
                agentio.EXIT_FAILURE,
                f"refused to write {rel}: {path} is not a real directory",
                "nothing was written through it; run undo --dry-run to see the plan",
            )
    return path


def _remove(ws: str, rel: str, kind: str) -> None:
    parent = _parent_checked(ws, rel)
    target = os.path.join(parent, rel.rsplit("/", 1)[-1])
    if kind == "dir":
        os.rmdir(target)
    else:
        os.unlink(target)


def _restore(store: Store, ws: str, e: Entry) -> None:
    rel = e["path"]
    parent = _parent_checked(ws, rel)
    name = rel.rsplit("/", 1)[-1]
    target = os.path.join(parent, name)
    if e["kind"] == "dir":
        try:
            st = os.lstat(target)
        except FileNotFoundError:
            os.mkdir(target, 0o700)
        else:
            if not stat.S_ISDIR(st.st_mode):
                raise agentio.ToolError(
                    agentio.EXIT_FAILURE,
                    f"refused to replace {rel}: it is not a directory",
                    "run undo --dry-run",
                )
        return  # its mode is set after everything inside it is written
    tmp = os.path.join(parent, f".{name}.undo-{os.getpid()}.tmp")
    if e["kind"] == "link":
        os.symlink(e["target"], tmp)
    else:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            with open(store.object_path(e["sha256"]), "rb") as fin:
                for block in iter(lambda: fin.read(CHUNK), b""):
                    os.write(fd, block)
            os.fchmod(fd, e["mode"])
        finally:
            os.close(fd)
    os.replace(tmp, target)  # rename replaces a symlink at the target, never follows it


def apply_plan(store: Store, ws: str, rec: dict[str, Any], plan: list[Change]) -> None:
    snap = {e["path"]: e for e in rec["entries"]}
    removals = [ch for ch in plan if ch["change"] == "remove"]
    for ch in sorted(removals, key=lambda c: (-c["path"].count("/"), c["path"]), reverse=False):
        _remove(ws, ch["path"], ch["kind"])
    restores = [snap[ch["path"]] for ch in plan if ch["change"] == "restore"]
    for e in sorted(
        (e for e in restores if e["kind"] == "dir"), key=lambda e: (e["path"].count("/"), e["path"])
    ):
        _restore(store, ws, e)
    for e in sorted((e for e in restores if e["kind"] != "dir"), key=lambda e: e["path"]):
        _restore(store, ws, e)
    for e in sorted(
        (e for e in restores if e["kind"] == "dir"), key=lambda e: (-e["path"].count("/"), e["path"])
    ):
        os.chmod(os.path.join(_parent_checked(ws, e["path"]), e["path"].rsplit("/", 1)[-1]), e["mode"])


# ── the trash (FR-39 to FR-41, D-18) ──────────────────────────────────────────────────────────
# What a delete removes, kept before it happens: <state root>/trash/items/<id>.json and the content,
# deduplicated, in trash/objects/. Not per workspace: a deleted path anywhere the agent owns is kept.
# What feeds it (the guards) is FOR-MENTOR Item 22's; `guard trash-put` is the entry point either way.

ENV_TRASH_MAX_AGE_DAYS = "TIMELIKE_TRASH_MAX_AGE_DAYS"
ENV_TRASH_MAX_BYTES = "TIMELIKE_TRASH_MAX_BYTES"
TRASH_DEFAULTS = {ENV_TRASH_MAX_AGE_DAYS: 30, ENV_TRASH_MAX_BYTES: 1024**3}


def trash_limits() -> dict[str, int]:
    out = {}
    for var, default in TRASH_DEFAULTS.items():
        raw = os.environ.get(var, "").strip()
        if raw == "":
            out[var] = default
        elif raw.isdigit():
            out[var] = int(raw)
        else:
            raise agentio.UsageError(
                f"{var} must be a non-negative whole number, not {raw!r}", f"e.g. {var}={default}, or 0 for none"
            )
    return out


class Trash(Store):
    """The trash shares the store's mechanics (objects, atomic writes, ids, the lock), not its records."""

    def __init__(self, ctx: agentio.Context) -> None:  # noqa: D107 — no workspace: the trash is global
        self.ctx = ctx
        self.ws = "trash"
        self.key = "trash"
        self.path = agentio.state_root() / "trash"

    def create(self) -> None:
        agentio.ensure_state_root()
        for sub in ("items", "objects"):
            (self.path / sub).mkdir(mode=0o700, parents=True, exist_ok=True)
        os.chmod(self.path, 0o700)

    def item_path(self, ident: int) -> Path:
        return self.path / "items" / f"{ident}.json"

    def items(self) -> list[dict[str, Any]]:
        out = []
        for p in (self.path / "items").glob("*.json"):
            with contextlib.suppress(OSError, ValueError):
                out.append(json.loads(p.read_text()))
        return sorted(out, key=lambda r: int(r["id"]))

    def item(self, ident: int) -> dict[str, Any] | None:
        with contextlib.suppress(OSError, ValueError):
            return dict(json.loads(self.item_path(ident).read_text()))
        return None


def _trash_walk(top: str) -> list[dict[str, Any]]:
    """`top` and, for a directory, everything below it; symlinks recorded, never followed."""
    out = []
    stack = [top]
    while stack:
        path = stack.pop()
        try:
            st = os.lstat(path)
        except OSError as e:
            out.append({"path": path, "kind": "other", "what": f"unreadable: {e.strerror or e}", "size": 0})
            continue
        perm = stat.S_IMODE(st.st_mode)
        if stat.S_ISLNK(st.st_mode):
            out.append({"path": path, "kind": "link", "target": os.readlink(path)})
        elif stat.S_ISDIR(st.st_mode):
            out.append({"path": path, "kind": "dir", "mode": perm})
            try:
                with os.scandir(path) as it:
                    stack.extend(sorted((e.path for e in it), reverse=True))
            except OSError as e:
                out[-1]["error"] = e.strerror or str(e)
        elif stat.S_ISREG(st.st_mode):
            out.append({"path": path, "kind": "file", "mode": perm, "size": st.st_size})
        else:
            out.append({"path": path, "kind": "other", "what": _other_kind(st.st_mode), "size": 0})
    return out


def trash_put(ctx: agentio.Context, paths: list[str], command: list[str]) -> dict[str, Any] | None:
    """Keep `paths` (as the deleting command names them) in the trash before they are deleted (FR-39).

    Returns the item, or None when none of the paths exists. A file the trash cannot keep (unreadable,
    not a file/link/directory, or past TIMELIKE_TRASH_MAX_BYTES on its own) is listed under `not_kept`,
    so the line naming the item can say what a later restore cannot bring back (T2).
    """
    limits = trash_limits()
    tops = [os.path.abspath(p) for p in paths if os.path.lexists(p)]
    if not tops:
        return None
    trash = Trash(ctx)
    trash.create()
    with trash.lock():
        entries: list[dict[str, Any]] = []
        not_kept: list[dict[str, Any]] = []
        total = 0
        cap = limits[ENV_TRASH_MAX_BYTES]
        for top in dict.fromkeys(tops):
            for e in _trash_walk(top):
                if e["kind"] == "other":
                    not_kept.append({"path": e["path"], "size": e["size"], "reason": e["what"]})
                    continue
                if e["kind"] == "file":
                    if cap and total + e["size"] > cap:
                        not_kept.append({"path": e["path"], "size": e["size"], "reason": f"over {ENV_TRASH_MAX_BYTES}"})
                        continue
                    try:
                        sha, read, _ = trash.put(e["path"])
                    except OSError as err:
                        not_kept.append({"path": e["path"], "size": e["size"], "reason": f"unreadable: {err.strerror or err}"})
                        continue
                    e = {**e, "sha256": sha, "size": read}
                    total += read
                entries.append({k: v for k, v in e.items() if k != "error"})
        item = {
            "v": RECORD_VERSION,
            "id": trash.next_id(),
            "deleted_at": datetime.now(UTC).isoformat(timespec="seconds"),
            "session": ctx.session,
            "agent": agent_id(),
            "command": command,
            "roots": list(dict.fromkeys(tops)),
            "entries": entries,
            "not_kept": not_kept,
            "files": sum(1 for e in entries if e["kind"] == "file"),
            "bytes": total,
        }
        trash._write_atomic(trash.item_path(item["id"]), json.dumps(item, indent=1) + "\n", 0o600)
        purge_trash(trash, limits, keep=item["id"])
    return item


def purge_trash(trash: Trash, limits: dict[str, int], keep: int) -> None:
    """FR-41: by age, then oldest first while the trash's content exceeds its cap; never `keep`."""
    age_s = limits[ENV_TRASH_MAX_AGE_DAYS] * 86400
    cap = limits[ENV_TRASH_MAX_BYTES]
    by_age = _records_by_age_in(trash.path / "items")
    now = time.time()
    dropped = False
    for mtime, ident in list(by_age):
        if ident != keep and age_s and now - mtime > age_s:
            _drop_trash(trash, ident, f"older than {limits[ENV_TRASH_MAX_AGE_DAYS]} days")
            by_age.remove((mtime, ident))
            dropped = True
    if dropped:
        _sweep_trash(trash)
    while cap and _object_bytes(trash.path) > cap:
        older = [(m, i) for m, i in by_age if i != keep]
        if not older:
            break
        _drop_trash(trash, older[0][1], f"over {ENV_TRASH_MAX_BYTES}")
        by_age.remove(older[0])
        _sweep_trash(trash)


def _records_by_age_in(d: Path) -> list[tuple[float, int]]:
    out = []
    with contextlib.suppress(OSError):
        for p in d.glob("*.json"):
            with contextlib.suppress(OSError, ValueError):
                out.append((p.stat().st_mtime, int(p.stem)))
    return sorted(out)


def _drop_trash(trash: Trash, ident: int, why: str) -> None:
    with contextlib.suppress(OSError):
        trash.item_path(ident).unlink()
    add_note(f"purged: trash item {ident} ({why})")


def _sweep_trash(trash: Trash) -> None:
    keep: set[str] = set()
    for item in trash.items():
        keep.update(e["sha256"] for e in item.get("entries", []) if e.get("kind") == "file")
    with contextlib.suppress(OSError):
        for sub in os.scandir(trash.path / "objects"):
            if sub.is_dir(follow_symlinks=False):
                for f in os.scandir(sub.path):
                    if f.name not in keep and not f.name.startswith("."):
                        with contextlib.suppress(OSError):
                            os.unlink(f.path)


def trash_line(item: dict[str, Any]) -> str:
    first = item["roots"][0]
    more = len(item["roots"]) - 1
    return f"{item['id']}  {item['files']} files  {human(item['bytes'])}  {first}" + (
        f" and {more} more" if more else ""
    )


def _trash_blocked(item: dict[str, Any]) -> list[str]:
    """Paths a put-back would overwrite, or whose parent is gone: refused, named, nothing written."""
    out = []
    for root in item["roots"]:
        if os.path.lexists(root):
            out.append(f"refused: {root} exists")
        elif not os.path.isdir(os.path.dirname(root)) or os.path.islink(os.path.dirname(root)):
            out.append(f"refused: {os.path.dirname(root)} is not a directory (put back what held it first)")
    return out


def _put_back(trash: Trash, item: dict[str, Any]) -> None:
    dirs = [e for e in item["entries"] if e["kind"] == "dir"]
    for e in sorted(dirs, key=lambda e: e["path"].count("/")):
        os.mkdir(e["path"], 0o700)
    for e in item["entries"]:
        if e["kind"] == "link":
            os.symlink(e["target"], e["path"])
        elif e["kind"] == "file":
            fd = os.open(e["path"], os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            try:
                with open(trash.object_path(e["sha256"]), "rb") as fin:
                    for block in iter(lambda: fin.read(CHUNK), b""):
                        os.write(fd, block)
                os.fchmod(fd, e["mode"])
            finally:
                os.close(fd)
    for e in sorted(dirs, key=lambda e: -e["path"].count("/")):
        os.chmod(e["path"], e["mode"])


def _put_back_differences(item: dict[str, Any]) -> list[str]:
    left = []
    for e in item["entries"]:
        try:
            st = os.lstat(e["path"])
        except OSError:
            left.append(f"missing {e['kind']} {e['path']}")
            continue
        if e["kind"] == "file":
            ok = stat.S_ISREG(st.st_mode) and file_sha(e["path"]) == e["sha256"]
        elif e["kind"] == "link":
            ok = stat.S_ISLNK(st.st_mode) and os.readlink(e["path"]) == e["target"]
        else:
            ok = stat.S_ISDIR(st.st_mode)
        if not ok:
            left.append(f"differs {e['kind']} {e['path']}")
    return left


def undo_trash(args: argparse.Namespace, ctx: agentio.Context, target: str) -> agentio.Result:
    """`undo --trash [ID] [--dry-run] [--yes]` (FR-40): list the trash, or put one item back, verified."""
    trash = Trash(ctx)
    if args.id is None:
        items = list(reversed(trash.items())) if trash.path.is_dir() else []
        lines = [trash_line(i) for i in items]
        data = {"items": [{k: i[k] for k in ("id", "files", "bytes", "roots", "session", "agent")} for i in items]}
        return agentio.Result(target, "trash", f"{len(items)} items in the trash", lines=lines, data=data)
    item = trash.item(int(args.id)) if trash.path.is_dir() else None
    scope = f"trash {args.id}"
    if item is None:
        ids = ", ".join(str(i["id"]) for i in reversed(trash.items())) if trash.path.is_dir() else ""
        raise Outcome(
            agentio.EXIT_NOT_FOUND,
            f"no trash item {args.id}",
            f"trash items: {ids}" if ids else "the trash is empty",
        )
    plan = [f"put back {e['kind']} {e['path']}" for e in item["entries"]]
    blocked = _trash_blocked(item)
    n = len(item["entries"])
    if args.dry_run:
        verdict = f"dry run: trash item {item['id']} — {n} to put back; nothing changed"
        if blocked:
            verdict += f"; {len(blocked)} blocked"
        lines = blocked + plan + [f"not kept: {x['path']} ({x['reason']})" for x in item.get("not_kept", [])]
        return agentio.Result(target, scope, verdict, lines=lines, data={"id": item["id"], "blocked": blocked})
    if blocked:
        raise Outcome(
            agentio.EXIT_FAILURE,
            f"refused: trash item {item['id']} would overwrite or has no place: {blocked[0].removeprefix('refused: ')}",
            "move what is there aside, or put back the item that held its directory first",
            blocked,
        )
    if not args.yes:
        if ctx.limit > 0 and len(plan) > ctx.limit:
            more = len(plan) - (ctx.limit - 1)
            plan = [*plan[: ctx.limit - 1], f"… and {more} more: undo --trash {item['id']} --dry-run --limit 0"]
        return agentio.confirm_required(ctx, target=target, scope=scope, plan=plan)
    with trash.lock():
        _put_back(trash, item)
        left = _put_back_differences(item)
    if left:
        raise Outcome(
            agentio.EXIT_FAILURE,
            f"put back trash item {item['id']} left {len(left)} differences",
            f"undo --trash {item['id']} --dry-run shows the item",
            left,
        )
    verdict = f"put back trash item {item['id']}: {n} paths; verified"
    return agentio.Result(target, scope, verdict, lines=plan, data={"id": item["id"], "verified": True})


# ── undo (FR-14 to FR-20) ─────────────────────────────────────────────────────────────────────


def undo_configure(p: argparse.ArgumentParser) -> None:
    p.add_argument("id", nargs="?", metavar="ID", help="the snapshot to restore (default: the newest)")
    p.add_argument("--trash", action="store_true", help="list the trash, or put trash item ID back")


def _choose(store: Store, ws: str, raw: str | None) -> dict[str, Any]:
    recs = store.records()
    if raw is not None and not raw.isdigit():
        raise agentio.UsageError(f"{raw!r} is not a snapshot id", "ids are numbers; see: snapshot list")
    if not recs:
        raise Outcome(
            agentio.EXIT_NOT_FOUND,
            f"no snapshot {raw or ''} for {ws}".replace("  ", " "),
            "take one with: snapshot",
            other_lines(ws)[0],  # FR-29: a moved workspace is told where its history is
        )
    if raw is None:
        # The newest snapshot the agent took, not a safety snapshot of an earlier undo: otherwise a
        # second `undo --yes` would undo the first, and undo would not be idempotent (rule 7). Safety
        # snapshots stay reachable by id (`undo 2 --yes` undoes an undo).
        chosen = [r for r in recs if not str(r["reason"]).startswith(SAFETY_PREFIX)]
        return (chosen or recs)[-1]
    rec = store.record(int(raw))
    if rec is None:
        ids = ", ".join(str(r["id"]) for r in reversed(recs))
        raise Outcome(agentio.EXIT_NOT_FOUND, f"no snapshot {raw} for {ws}", f"snapshots here: {ids}")
    return rec


def undo_main(args: argparse.Namespace, ctx: agentio.Context) -> agentio.Result:
    if args.id is not None and not args.id.isdigit():
        raise agentio.UsageError(f"{args.id!r} is not a snapshot id", "ids are numbers; see: snapshot list")
    if args.yes and not args.dry_run:
        caps_from_env()  # bad values are usage errors before a restore starts, not after it ends
        purge_limits()
    ws = find_workspace()
    state = note_persistence()
    try:
        r = undo_trash(args, ctx, ws) if args.trash else _undo(args, ctx, ws)
    except Outcome as o:
        r = o.result(ws, f"trash {args.id}" if args.trash and args.id else "trash" if args.trash else f"restore {args.id or 'newest'}")
    return finish(r, state)


def _undo(args: argparse.Namespace, ctx: agentio.Context, ws: str) -> agentio.Result:
    check_workspace(ws, ctx, "undo")
    store = Store(ctx, ws)
    import_slice0(store)
    if store.exists():
        store.check_owner()
    rec = _choose(store, ws, args.id)
    ident = rec["id"]
    scope = f"restore {ident}"
    if args.dry_run or not args.yes:
        plan = make_plan(ws, rec)
        lines = [plan_line(ch) for ch in plan]
        n_restore, n_remove = counts(plan)
        if args.dry_run:
            verdict = (
                f"dry run: snapshot {ident} — {n_restore} to restore, {n_remove} to remove; nothing changed"
                if n_restore or n_remove
                else f"dry run: snapshot {ident} — nothing to change"
            )
            data = {"id": ident, "restore": n_restore, "remove": n_remove, "plan": plan}
            return agentio.Result(ws, scope, verdict, lines=lines, data=data)
        if not (n_restore or n_remove):
            return agentio.Result(
                ws, scope, f"nothing to restore: the workspace matches snapshot {ident}", data={"id": ident}
            )
        if ctx.limit > 0 and len(lines) > ctx.limit:
            more = len(lines) - (ctx.limit - 1)
            lines = [*lines[: ctx.limit - 1], f"… and {more} more: undo {ident} --dry-run --limit 0"]
        return agentio.confirm_required(ctx, target=ws, scope=scope, plan=lines)
    with store.lock():
        plan = make_plan(ws, rec)
        n_restore, n_remove = counts(plan)
        if not (n_restore or n_remove):
            return agentio.Result(
                ws, scope, f"nothing to restore: the workspace matches snapshot {ident}", data={"id": ident}
            )
        try:
            before = take_locked(store, caps_from_env(), f"{SAFETY_PREFIX}{ident}", None)
        except Outcome as o:
            raise Outcome(
                agentio.EXIT_FAILURE,
                f"restore of snapshot {ident} not started: the snapshot of the state it would replace"
                f" failed: {o.verdict}",
                f"nothing was changed; run undo {ident} --yes again; if this repeats, the store"
                f" {store.path} is damaged: remove it and take a new snapshot",
            ) from None
        try:
            apply_plan(store, ws, rec, plan)
        except agentio.ToolError as e:
            raise agentio.ToolError(
                e.code, e.what, f"{e.remediation}; the state before is snapshot {before['id']}"
            ) from None
        except OSError as e:
            raise agentio.ToolError(
                agentio.EXIT_FAILURE,
                f"restore of snapshot {ident} stopped: {e.strerror or e} ({e.filename})",
                f"the state before is snapshot {before['id']}; undo {before['id']} --yes returns to it",
            ) from None
        left = [ch for ch in make_plan(ws, rec) if ch["change"] != "keep"]
        purged = purge(store) if not left else []
    if left:
        raise Outcome(
            agentio.EXIT_FAILURE,
            f"restore of snapshot {ident} left {len(left)} differences;"
            f" the state before is snapshot {before['id']}",
            f"undo {before['id']} --yes returns to the state before;"
            f" undo {ident} --dry-run shows what differs",
            [plan_line(ch) for ch in left],
        )
    partial = " (partial)" if before["partial"] else ""
    verdict = (
        f"restored to snapshot {ident}: {n_restore} restored, {n_remove} removed; verified;"
        f" the state before is snapshot {before['id']}{partial}"
    )
    shown, cut = cut_or_lines(ctx, store, "undo", [plan_line(ch) for ch in plan])
    data = {
        "id": ident,
        "restored": n_restore,
        "removed": n_remove,
        "verified": True,
        "before": before["id"],
        "before_partial": before["partial"],
        "purged": purged,
    }
    return agentio.Result(ws, scope, verdict, lines=shown, data=data, cut=cut)


if __name__ == "__main__":
    agentio.run(TOOL, main, configure=configure)
