#!/opt/timelike/python/bin/python3 -I
"""view — show a numbered window of a file, bounded, ending with the command for the next window (P2, P3).

`view FILE` shows lines 1-120 (or the whole file when it is shorter); `view FILE:A-B` a range;
`view FILE:N` line N with 10 lines of context each side. A window that shows less than the whole file is
cut output (rule 3): it ends with the omission line, whose full output is the file itself and whose
`more:` is the next window's command. A whole-file view has no omission line. A binary file prints its
type and size instead of content.

Design: .specswarm/features/006-bounded-read/ (spec, research R3-R5, data-model.md,
contracts/view-search-cli.md).
"""

from __future__ import annotations

import argparse
import codecs
import importlib.machinery
import importlib.util
import os
import re
import shlex
import stat
import sys
from types import ModuleType
from typing import Any

import agentio

WINDOW = 120
CONTEXT = 10
SNIFF = 8192
OVERVIEW_COUNT_CAP = 100_000  # entries counted per collapsed directory before "100000+" (spec FR-30)
VCS_DIRS = frozenset({".git", ".hg", ".svn"})
DEPENDENCY_DIRS = frozenset(
    {"node_modules", "bower_components", "jspm_packages", "vendor", ".venv", "venv", "site-packages"}
    | {"Pods", ".bundle", "elm-stuff"}
)  # fmt: skip
BUILD_DIRS = frozenset(
    {"build", "dist", "target", "__pycache__", ".mypy_cache", ".pytest_cache", ".ruff_cache", ".tox"}
    | {".nox", ".gradle", ".next", ".nuxt", ".cache", "coverage", ".terraform"}
)  # fmt: skip
_SPEC_RE = re.compile(r"^(.+):(\d+)(?:-(\d+))?$")
# Rule 13, as agentio applies it, plus any ESC its pattern leaves behind: conform's C8 rejects a bare one.
_ANSI_RE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[@-Z\\-_]")
_MAGIC: tuple[tuple[int, bytes, str], ...] = (
    (0, b"\x7fELF", "ELF"),
    (0, b"\x89PNG\r\n\x1a\n", "PNG"),
    (0, b"\xff\xd8\xff", "JPEG"),
    (0, b"GIF8", "GIF"),
    (0, b"\x1f\x8b", "gzip"),
    (0, b"PK\x03\x04", "zip"),
    (0, b"%PDF", "PDF"),
    (0, b"SQLite format 3\x00", "SQLite"),
    (257, b"ustar", "tar"),
)

TOOL = agentio.Tool(
    name="view",
    target="file",
    summary="show a numbered window of a file (120 lines); ends with the command for the next window",
    usage=[
        "view FILE              # lines 1-120, or the whole file if it is shorter",
        "view FILE:A-B          # lines A to B",
        "view FILE:N            # line N with 10 lines of context each side, N marked >",
        "view FILE --limit 0    # the whole file, when you mean it",
        "view DIR               # overview in 200 lines; dependency, build and .git dirs collapsed",
        "view --anchors FILE    # each line with a 6-hex anchor of its content (edit accepts N:anchor)",
        "a binary file prints its type and size, not its bytes; search finds text across files",
        "note: where vim is installed, its `view` is shadowed (/opt/timelike/bin is first on PATH)",
    ],
    probe=("/etc/os-release",),
    exit_codes={
        agentio.EXIT_OK: "ok",
        agentio.EXIT_FAILURE: "the file could not be read",
        agentio.EXIT_USAGE: "usage",
        agentio.EXIT_NOT_FOUND: "no such file",
    },
    manifest_extra=lambda: {"window": WINDOW, "context": CONTEXT},
)


class Outcome(Exception):
    """A missing or unreadable file: a verdict on stdout (contract § Outcomes), not a stderr error."""

    def __init__(self, code: int, scope: str, verdict: str, remedy: str | None = None) -> None:
        super().__init__(verdict)
        self.code, self.scope, self.verdict, self.remedy = code, scope, verdict, remedy

    def result(self, target: str) -> agentio.Result:
        lines = [f"do instead: {self.remedy}"] if self.remedy else []
        data = {"remedy": self.remedy} if self.remedy else {}
        return agentio.Result(target, self.scope, self.verdict, lines=lines, data=data, exit=self.code)


def human(n: int) -> str:
    if n < 1024:
        return f"{n} B"
    size = float(n)
    for unit in ("KiB", "MiB", "GiB", "TiB"):
        size /= 1024
        if size < 1024 or unit == "TiB":
            return f"{size:.1f} {unit}"
    raise AssertionError("unreachable")


def resolve(arg: str) -> tuple[str, int | None, int | None, bool]:
    """FILE as given, the range (A, B), and whether it is `FILE:N`. A file that exists wins, colon and all."""
    m = _SPEC_RE.match(arg)
    if os.path.lexists(arg) or not m:
        return arg, None, None, False
    a = int(m.group(2))
    if m.group(3) is None:
        return m.group(1), a, None, True
    return m.group(1), a, int(m.group(3)), False


def file_type(head: bytes) -> str:
    for offset, magic, name in _MAGIC:
        if head[offset : offset + len(magic)] == magic:
            return name
    return "data"


class _Decoder:
    """UTF-8 with each undecodable byte replaced and counted (research R4)."""

    def __init__(self) -> None:
        self.replaced = 0
        self.name = f"view-count-{id(self)}"
        codecs.register_error(self.name, self._handle)

    def _handle(self, exc: UnicodeError) -> tuple[str, int]:
        if not isinstance(exc, UnicodeDecodeError):
            raise exc
        self.replaced += exc.end - exc.start
        return "�" * (exc.end - exc.start), exc.end

    def decode(self, raw: bytes) -> str:
        return raw.decode("utf-8", self.name)


def clean(text: str) -> tuple[str, bool]:
    if "\x1b" not in text:
        return text, False
    return _ANSI_RE.sub("", text).replace("\x1b", ""), True


def configure(p: argparse.ArgumentParser) -> None:
    # Optional to argparse, required by main(): a required positional would make argparse refuse --help
    # and --agent-info before agentio handles them (the adele and snapshot pattern).
    p.add_argument("file", nargs="?", metavar="FILE[:A-B|:N]|DIR", help="the file and range, or a directory")
    p.add_argument("--anchors", action="store_true", help="show each line's anchor (6 hex of its sha256)")
    p.add_argument(
        "--no-ignore", dest="no_ignore", action="store_true", help="overview: list ignored entries"
    )
    p.add_argument(
        "--columns",
        type=int,
        metavar="N",
        help="cut lines at N characters for this call (default COLUMNS; 0 = whole lines)",
    )


def main(args: argparse.Namespace, ctx: agentio.Context) -> agentio.Result:
    if not args.file:
        raise agentio.UsageError("view needs a FILE", "run view FILE, view FILE:A-B or view FILE:N")
    if args.columns is not None:
        if args.columns < 0:
            raise agentio.UsageError(
                f"--columns {args.columns} is negative", "use --columns N, or 0 for whole lines"
            )
        ctx.columns = args.columns  # discovery revision 12: reading long lines whole is an explicit request
    path, a, b, single = resolve(args.file)
    try:
        if a is None and os.path.isdir(path):
            if args.anchors:
                raise agentio.UsageError(
                    f"--anchors needs a file; {path} is a directory", f"view --anchors FILE, or view {path}"
                )
            return overview(ctx, path, not args.no_ignore)
        return show(ctx, path, a, b, single, args.anchors)
    except Outcome as o:
        return o.result(path)


def show(
    ctx: agentio.Context, path: str, a: int | None, b: int | None, single: bool, anchors: bool = False
) -> agentio.Result:
    try:
        st = os.stat(path)
    except FileNotFoundError:
        raise Outcome(
            agentio.EXIT_NOT_FOUND,
            "not found",
            f"no such file: {path}",
            "check the name; search for it with: "
            + shlex.join(["search", "-F", os.path.basename(path), "."]),
        ) from None
    except OSError as e:
        raise Outcome(agentio.EXIT_FAILURE, "unreadable", f"cannot read {path}: {e.strerror or e}") from None
    if stat.S_ISDIR(st.st_mode):
        raise agentio.UsageError(
            f"{path} is a directory", f"view a file in it, or: {shlex.join(['search', 'PATTERN', path])}"
        )
    abs_path = os.path.realpath(path)
    try:
        f = open(path, "rb")  # noqa: SIM115 — closed below, after the streaming read
    except OSError as e:
        raise Outcome(agentio.EXIT_FAILURE, "unreadable", f"cannot read {path}: {e.strerror or e}") from None
    with f:
        head = f.read(SNIFF)
        if b"\x00" in head:
            size = st.st_size
            kind = file_type(head)
            return agentio.Result(
                path,
                "binary",
                f"binary file: {kind}, {human(size)} ({size} bytes); content not shown",
                data={"path": path, "abs_path": abs_path, "binary": True, "type": kind, "size": size},
            )
        f.seek(0)
        return window(ctx, f, path, abs_path, a, b, single, anchors)


# ── the overview: view DIR (slice 1; spec FR-24 to FR-31, research R7, R8) ───────────────────────


def _search() -> ModuleType:
    """search's ignore rules, from the file beside this one: one implementation (as undo loads snapshot)."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "search")
    try:
        loader = importlib.machinery.SourceFileLoader("timelike_search", path)
        spec = importlib.util.spec_from_loader("timelike_search", loader)
        if spec is None:
            raise ImportError(f"cannot load {path}")
        module = importlib.util.module_from_spec(spec)
        sys.modules["timelike_search"] = module  # dataclasses look the module up by name
        loader.exec_module(module)
    except (OSError, ImportError) as e:
        raise agentio.ToolError(
            agentio.EXIT_FAILURE,
            f"cannot load the ignore rules from {path}: {e}",
            "view needs timelike's search beside it; reinstall the tools",
        ) from None
    return module


def _n(count: int, word: str, complete: bool = True) -> str:
    return f"{count}{'' if complete else '+'} {word}{'' if count == 1 and complete else 's'}"


class Node:
    __slots__ = (
        "bytes", "children", "collapse", "complete", "dirs", "expanded", "files", "kind", "name",
        "path", "size", "target",
    )  # fmt: skip

    def __init__(self, name: str, path: str, kind: str) -> None:
        self.name, self.path, self.kind = name, path, kind  # kind: dir | file | link | unreadable
        self.size = 0
        self.target = ""
        self.children: list[Node] = []
        self.collapse: str | None = None  # vcs | dependency | build | ignored | budget
        self.expanded = False
        self.files = self.dirs = self.bytes = 0  # everything below a directory, recursively
        self.complete = True


def _collapse_kind(name: str) -> str | None:
    if name in VCS_DIRS:
        return "vcs"
    if name in DEPENDENCY_DIRS:
        return "dependency"
    if name in BUILD_DIRS or name.endswith(".egg-info"):
        return "build"
    return None


def _count(node: Node) -> None:
    """Count a collapsed directory: files, dirs and bytes below it, capped (FR-30); no symlink followed."""
    stack = [node.path]
    seen = 0
    while stack:
        try:
            with os.scandir(stack.pop()) as it:
                entries = list(it)
        except OSError:
            node.complete = False
            continue
        for e in entries:
            seen += 1
            if seen > OVERVIEW_COUNT_CAP:
                node.complete = False
                return
            try:
                if e.is_dir(follow_symlinks=False):
                    node.dirs += 1
                    stack.append(e.path)
                else:
                    node.files += 1
                    if e.is_file(follow_symlinks=False):
                        node.bytes += e.stat(follow_symlinks=False).st_size
            except OSError:
                node.complete = False


class _Walk:
    def __init__(self, search: ModuleType, use_ignore: bool) -> None:
        self.search = search
        self.use_ignore = use_ignore
        self.ignored_files = 0
        self.unreadable = 0

    def build(self, node: Node, rel: str, active: list[Any]) -> None:
        if self.use_ignore:
            text = self.search._read_text(os.path.join(node.path, ".gitignore"))
            if text:
                active = active + self.search.parse_ignore(text, rel)
        try:
            with os.scandir(node.path) as it:
                entries = list(it)
        except OSError:
            node.kind = "unreadable"
            node.complete = False
            self.unreadable += 1
            return
        dirs: list[Node] = []
        files: list[Node] = []
        for e in entries:
            child_rel = f"{rel}/{e.name}" if rel else e.name
            child_path = os.path.join(node.path, e.name)
            try:
                is_link = e.is_symlink()
                is_dir = not is_link and e.is_dir(follow_symlinks=False)
            except OSError:
                self.unreadable += 1
                continue
            ignored = self.use_ignore and self.search.ignored(active, child_rel, is_dir)
            if is_dir:
                child = Node(e.name, child_path, "dir")
                kind = _collapse_kind(e.name)
                if kind == "vcs" or (kind is None and ignored):
                    kind = kind or "ignored"
                if kind is not None:
                    child.collapse = kind
                    _count(child)
                else:
                    self.build(child, child_rel, active)
                dirs.append(child)
                node.dirs += 1 + child.dirs
                node.files += child.files
                node.bytes += child.bytes
                node.complete = node.complete and child.complete
                continue
            if ignored:
                self.ignored_files += 1
                continue
            child = Node(e.name, child_path, "link" if is_link else "file")
            if is_link:
                try:
                    child.target = os.readlink(child_path)
                except OSError:
                    child.target = "?"
            else:
                try:
                    child.size = e.stat(follow_symlinks=False).st_size
                except OSError:
                    child.size = 0
            node.files += 1
            node.bytes += child.size
            files.append(child)
        node.children = sorted(dirs, key=lambda n: n.name) + sorted(files, key=lambda n: n.name)


def _fit(root: Node, budget: int) -> None:
    """Expand breadth-first while each directory's entries fit the lines left (FR-29)."""
    root.expanded = True
    used = len(root.children)
    queue = [c for c in root.children if c.kind == "dir" and c.collapse is None]
    while queue:
        d = queue.pop(0)
        if budget == 0 or used + len(d.children) <= budget:
            d.expanded = True
            used += len(d.children)
            queue.extend(c for c in d.children if c.kind == "dir" and c.collapse is None)
        else:
            d.collapse = "budget"


def _lines(node: Node, depth: int, search: ModuleType, out: list[str], collapsed: list[Node]) -> None:
    indent = "  " * depth
    for c in node.children:
        if c.kind == "file":
            out.append(f"{indent}{c.name}  {human(c.size)}")
        elif c.kind == "link":
            out.append(f"{indent}{c.name} -> {c.target}")
        elif c.kind == "unreadable":
            out.append(f"{indent}{c.name}/  unreadable")
        elif c.expanded:
            out.append(f"{indent}{c.name}/")
            _lines(c, depth + 1, search, out, collapsed)
        else:
            kind = c.collapse or "budget"
            c.collapse = kind
            expand = shlex.join(["view", search.display(c.path).rstrip("/") + "/"])
            out.append(
                f"{indent}{c.name}/  {_n(c.files, 'file', c.complete)}, {_n(c.dirs, 'dir', c.complete)}, "
                f"{human(c.bytes)}; {kind} — expand: {expand}"
            )
            collapsed.append(c)


def overview(ctx: agentio.Context, path: str, use_ignore: bool) -> agentio.Result:
    search = _search()
    root = Node(os.path.basename(os.path.normpath(path)), path, "dir")
    walk = _Walk(search, use_ignore)
    rules, frame = search.base_rules(os.path.realpath(path)) if use_ignore else ([], "")
    walk.build(root, frame, rules)
    _fit(root, ctx.limit)
    lines: list[str] = []
    collapsed: list[Node] = []
    _lines(root, 0, search, lines, collapsed)

    order = ("vcs", "dependency", "build", "ignored", "budget")
    kinds = {k: sum(1 for c in collapsed if c.collapse == k) for k in order}
    verdict = (
        f"{_n(root.files, 'file', root.complete)}, {_n(root.dirs, 'dir', root.complete)}, "
        f"{human(root.bytes)} under {path}"
    )
    if collapsed:
        listed = ", ".join(f"{k} {n}" for k, n in kinds.items() if n)
        verdict += f"; collapsed {len(collapsed)} ({listed})"
    if walk.ignored_files:
        verdict += f"; {_n(walk.ignored_files, 'ignored file')} not listed"
    if walk.unreadable:
        verdict += f"; {walk.unreadable} unreadable"
    data = {
        "overview": True,
        "path": path,
        "abs_path": os.path.realpath(path),
        "files": root.files,
        "dirs": root.dirs,
        "bytes": root.bytes,
        "ignored_files": walk.ignored_files,
        "budget_lines": ctx.limit,
        "collapsed": [
            {
                "path": search.display(c.path),
                "kind": c.collapse,
                "files": c.files,
                "dirs": c.dirs,
                "bytes": c.bytes,
                "complete": c.complete,
                "expand": shlex.join(["view", search.display(c.path).rstrip("/") + "/"]),
            }
            for c in collapsed
        ],
    }
    return agentio.Result(path, "overview", verdict, lines=lines, data=data)


def anchor_of(body: bytes) -> str:
    """FR-33: the first 6 hex of the SHA-256 of a line's raw bytes, its line ending already removed."""
    import hashlib  # deferred: only --anchors needs it

    return hashlib.sha256(body).hexdigest()[:6]


def window(
    ctx: agentio.Context,
    f: Any,
    path: str,
    abs_path: str,
    a: int | None,
    b: int | None,
    single: bool,
    anchors: bool = False,
) -> agentio.Result:
    # The requested range, before the file's length is known (data-model § Window rules).
    if single and a is not None:
        start, want_end, target = max(1, a - CONTEXT), a + CONTEXT, a
    elif a is not None:
        start, want_end, target = a, (b if b is not None else a), None
    else:
        start, want_end, target = 1, (0 if ctx.limit == 0 else WINDOW), None  # 0: to the end
    if ctx.limit > 0 and want_end and want_end - start + 1 > ctx.limit:
        want_end = start + ctx.limit - 1

    total = total_bytes = shown_bytes = 0
    raws: list[bytes] = []
    for raw in f:
        total += 1
        total_bytes += len(raw)
        if total >= start and (not want_end or total <= want_end):
            raws.append(raw)
            shown_bytes += len(raw)

    # Validation needs the length; a bad range names it (contract § Refusals and errors).
    requested_end = b if (a is not None and not single and b is not None) else None
    if a is not None:
        if a < 1 or (requested_end is not None and a > requested_end):
            raise agentio.UsageError(f"bad range {path}:{a}-{requested_end}", f"{path} has {total} lines")
        if a > total:
            raise agentio.UsageError(
                f"line {a} is past the end: {path} has {total} lines",
                f"view {shlex.quote(path)}:{max(1, total - WINDOW + 1)}-{total}"
                if total
                else f"{path} is empty",
            )
    if total == 0:
        return agentio.Result(
            path,
            "empty",
            "empty file (0 lines)",
            data=_data(path, abs_path, 0, 0, 0, None, None, False, 0, 0),
        )

    end = min(want_end, total) if want_end else total
    clipped = requested_end is not None and requested_end > total
    width = len(str(total))
    decoder = _Decoder()
    lines: list[str] = []
    anchored: list[str] = []
    escapes = 0
    for n, raw in enumerate(raws, start):
        body = raw[:-1] if raw.endswith(b"\n") else raw
        if body.endswith(b"\r"):
            body = body[:-1]
        text, had = clean(decoder.decode(body))
        escapes += had
        marker = ">" if n == target else " "
        if anchors:  # D-9's column: number, marker, anchor, text
            mark = anchor_of(body)
            anchored.append(f"{n}:{mark}")
            lines.append(f"{n:>{width}}{marker}{mark} {text}")
        else:
            lines.append(f"{n:>{width}}{marker} {text}")
    flag = ["--anchors"] if anchors else []  # FR-35: continuing keeps the mode

    scope = f"lines {start}-{end} of {total}"
    whole = start == 1 and end == total
    notes = [f"clipped to {total}"] if clipped else []
    if decoder.replaced:
        notes.append(f"{_n(decoder.replaced, 'undecodable byte')} shown as U+FFFD")
    if escapes:
        notes.append(f"{_n(escapes, 'line')} had terminal escapes stripped")
    verdict = "; ".join([scope + (" (whole file)" if whole else ""), *notes])

    nxt = shlex.join(["view", *flag, f"{path}:{end + 1}-{end + WINDOW}"]) if end < total else None
    data = _data(path, abs_path, total, start, end, target, nxt, clipped, decoder.replaced, escapes)
    if anchors:
        data["anchors"] = anchored
    shown = len(lines)
    long_lines = sum(len(x) > ctx.columns for x in lines) if ctx.columns > 0 else 0
    if long_lines:
        # Discovery revision 12 and D5: the closing lines give the exact command that reads them whole.
        whole_cmd = shlex.join(["view", *flag, f"{path}:{start}-{end}", "--columns", "0"])
        lines.append(f"long lines cut: {long_lines}; read them whole with: {whole_cmd}")
        data["long_lines_cut"] = long_lines
    footer = 1 if long_lines else 0
    if whole:
        return agentio.Result(path, scope, verdict, lines=lines, data=data, footer=footer)
    more = nxt or shlex.join(["view", *flag, f"{path}:{max(1, start - WINDOW)}-{start - 1}"])
    cut = agentio.Cut([(scope, lines)], total - shown, total_bytes - shown_bytes, abs_path, more)
    return agentio.Result(path, scope, verdict, data=data, cut=cut, footer=footer)


def _data(
    path: str,
    abs_path: str,
    total: int,
    start: int,
    end: int,
    target: int | None,
    nxt: str | None,
    clipped: bool,
    replaced: int,
    escapes: int,
) -> dict[str, Any]:
    return {
        "path": path,
        "abs_path": abs_path,
        "total": total,
        "start": start,
        "end": end,
        "target_line": target,
        "next": nxt,
        "clipped": clipped,
        "replaced_bytes": replaced,
        "escape_lines": escapes,
    }


if __name__ == "__main__":
    agentio.run(TOOL, main, configure=configure)
